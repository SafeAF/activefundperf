<link rel="https://api.w.org/" href="https://www.defianceetfs.com/wp-json/" /><link rel="alternate" title="JSON" type="application/json" href="https://www.defianceetfs.com/wp-json/wp/v2/pages/8228" /><style type="text/css" id="simple-css-output">#distributions #table-top-holdings { display:none;}.distributions-not-allowed { font-family: 'Surt', sans-serif !important; font-size: 14px !important; line-height: 1.55 !important; color: rgba(10, 10, 10, 0.55) !important;}p.morningStar { display:none;}#etfs-page-main { background-color: #f7f7fd;}/* ============================================================ KADENCE INFO BOX — match Reasons card treatment ============================================================ */.kt-blocks-info-box-link-wrap { background: #fff; border: 1px solid rgba(0,0,0,0.06); border-radius: 14px; position: relative; overflow: hidden;}/* Brand-blue gradient strip on top */.kt-blocks-info-box-link-wrap::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #2438e8 0%, #6b8aff 100%); border-radius: 14px 14px 0 0; opacity: 0.85; z-index: 1;}/* ============================================================ FORCE UNIFORM CARD WIDTHS ACROSS ALL ETF PAGE SECTIONS ============================================================ */#etfs-page-description,#etfs-page-charts,.fund-details-section,.etfs-page-tables,#distributions { padding-left: 24px !important; padding-right: 24px !important;}#etfs-page-description > .container,#etfs-page-charts > .container,.fund-details-section > .container,.etfs-page-tables > .container,#distributions > .container { max-width: 1140px !important; margin-left: auto !important; margin-right: auto !important; padding-left: 0 !important; padding-right: 0 !important; width: 100% !important;}/* Cards inside .row must be edge-to-edge of container */.etfs-page-tables .row,#etfs-page-charts > .container > .row,#etfs-page-description .row,#distributions .row,#distributions .distributions-card { margin-left: 0 !important; margin-right: 0 !important; width: 100% !important; max-width: 100% !important; box-sizing: border-box !important;}/* Inner col-* divs must not add padding that shrinks the card */.etfs-page-tables .row > [class*="col-"],#etfs-page-charts > .container > .row > [class*="col-"],#etfs-page-description .row > [class*="col-"],#distributions .row > [class*="col-"],#distributions .distributions-card > [class*="col-"] { padding-left: 0 !important; padding-right: 0 !important; flex: 0 0 100% !important; max-width: 100% !important; width: 100% !important;}#etfs-page-documents .see_full_table { display: none;}/* Hide WordPress spacer blocks between ETF page sections */#distributions + .wp-block-spacer,.etfs-page-tables + .wp-block-spacer,section + .wp-block-spacer { display: none !important;}/*RKNG hide old distributions table*/.postid-16152 section#distributions table#table-top-holdings.def-table.distribution-table-wrp { display: none !important;}/*JEDI hide old distributions table*/.postid-13733 section#distributions table#table-top-holdings.def-table.distribution-table-wrp { display: none !important;}.tablepress>:where(thead,tfoot)>tr>* { background-color: #fafafb!important;}.def-table-wrp.table-responsive.distributions { padding:12px!important;}table.def-dist-table { border-radius: 0px!important;}/*.\.hide-me-cait{ display:none!important;}*/.kt-tab-title:hover { color: black !important;}p.video-placeholder-text-normal { display:none!Important;}.container.fund-details { margin-bottom: 80px;}.etfs-page-description-text { margin-bottom:0px!important;}/* ------ This section controls the visibility of the IONX, HIMZ, and RKLX funds ----- *//* -- IONX HERE .wp-block-kadence-column.kadence-column15_8bab5f-84.kb-section-has-link.kb-section-dir-vertical.ticker\.home\.block.\.ionx\.launch,span.\.ionx\.launch,table#tablepress-3 tr.row-12,.blog-alert:has(a[href="/ionx-full-holdings/"]),.blog-alert:has(a[href="/ionx/Prospectus"]) { display:non