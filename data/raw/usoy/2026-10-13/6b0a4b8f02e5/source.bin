		/* Basic style for the first level menu */
.header-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
}

.header-menu li {
    position: relative;
}

.header-menu ul ul {
    display: none;
    position: absolute;
    left: 100%; /* Positioning for the second-level dropdown */
    top: 0;
}

.header-menu ul ul ul {
    display: none;
    position: absolute;
    left: 100%; /* Positioning for the third-level dropdown */
    top: 0;
}

/* Show the second level when hovering over a first-level item */
.header-menu li:hover > ul {
    display: block;
}

/* Show the third level when hovering over a second-level item */
.header-menu ul ul li:hover > ul {
    display: block;
