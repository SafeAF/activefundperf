    gap: 16px;
  }
}

@media (max-width: 560px) {
  .def-news-section { padding: 48px 16px 64px; }
  .def-news-grid {
    grid-template-columns: 1fr !important;
  }
  .def-news-card { padding: 18px 20px; }
}


/* ============================================================
   FOOTER
   ============================================================ */
.def-footer {
  background: #050510;
  color: #fff;
  padding: 64px 24px 32px;
  margin: 0;
  font-family: 'Surt', sans-serif;
  position: relative;
}

.def-footer::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  height: 60px;
  background: #050510;
}

.def-footer-inner {
  max-width: 1140px;
  margin: 0 auto;
  text-align: center;
}

.def-footer-links {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 0;
  padding: 24px 0;
  border-top: 1px solid rgba(255,255,255,0.08);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  margin-bottom: 24px;
}

.def-footer-links a {
  font-family: 'Surt', sans-serif;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.2px;
  color: rgba(255,255,255,0.85);
  text-decoration: none;
  padding: 4px 16px;
  position: relative;
  transition: color 0.2s;
}

.def-footer-links a:hover { color: #7a8eff; }

.def-footer-links a + a::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1px;
  height: 11px;
  background: rgba(255,255,255,0.15);
}

.def-footer-disclosure {
  max-width: none;
  margin: 0 0 32px 0;
  text-align: left;
}

.def-footer-disclosure p {
  font-family: 'Surt', sans-serif;
  font-size: 16px;
  line-height: 1.6;
  color: rgba(255,255,255,0.75);
  margin: 0 0 16px 0;
  font-weight: 400;
}

.def-footer-disclosure p:last-child {
  margin-bottom: 0;
}

.def-footer-disclosure strong {
  color: rgba(255,255,255,0.95);
  font-weight: 700;
}

.def-footer-disclosure a {
  color: #7a8eff;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s;
}

.def-footer-disclosure a:hover { color: #c8d3ff; }

.def-footer-disclosure-etf {
  margin: 16px 0;
}

.def-footer-disclosure-etf p {
  font-family: 'Surt', sans-serif;
  font-size: 16px;
  line-height: 1.6;
  color: rgba(255,255,255,0.75);
  margin: 0 0 16px 0;
}

.def-footer-brand-copyright {
  font-family: 'Surt', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.5);
  margin: 0;
  letter-spacing: 0.3px;
}

@media (max-width: 700px) {
  .def-footer { padding: 40px 16px 28px; }
  .def-footer-links { gap: 4px 0; padding: 20px 0; }
  .def-footer-links a { padding: 4px 12px; font-size: 13px; }
  .def-footer-links a + a::before { height: 10px; }
  .def-footer-disclosure p,
  .def-footer-disclosure-etf p { font-size: 16px; line-height: 1.6; }
}
</style>


<!-- ============================================================
     CONTACT MODAL (preserved from previous footer)
     ============================================================ -->
<div class="modal fade" id="contact-us">
  <div class="modal-dialog">
    <div class="modal-content black">
      <div class="modal-header">
        <h5 class="modal-title">Contact us</h5>
        <p class="modal-subtitle">Fill the form below and we will get back to you as soon as possible.</p>
        <button type="button" class="close" data-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="modal-form"></div>
      </div>
    </div>
  </div>
</div>


<!-- ============================================================
     MOBILE MEGA MENU TOGGLE (preserved from previous footer)
     ============================================================ -->
<script>
document.addEventListener('click', function (e) {
  if (!window.matchMedia('(max-width: 768px)').matches) return;

  const link = e.target.closest(
    '#mega-menu-wrap-menu-1 #mega-menu-menu-1 > li.mega-menu-item-has-children > a.mega-menu-link'
  );
  if (!link) return;

  const li = link.closest('li.mega-menu-item-has-children');
  if (!li) return;

  e.preventDefault();
  e.stopPropagation();
  e.stopImmediatePropagation();

  const isOpen = li.classList.contains('mega-toggle-on');

  document.querySelectorAll(
    '#mega-menu-wrap-menu-1 #mega-menu-menu-1 > li.mega-toggle-on'
  ).forEach(openLi => {
    if (openLi !== li) openLi.classList.remove('mega-toggle-on');
  });

  li.classList.toggle('mega-toggle-on', !isOpen);
}, true);
</script>




