  <style>
    .def-dist-ui { width:100%; }
    .def-dist-topbar, .def-dist-bottombar{
      display:flex; justify-content:space-between; align-items:center; gap:12px;
      margin:10px 0;
      flex-wrap:wrap;
    }

    .def-dist-length{ display:flex; align-items:center; gap:10px; }
    .def-dist-perpage{
      padding:4px 6px;
      font-size:13px;
      border:1px solid #d0d0d0;
      border-radius:6px;
      background:#fff;
      height:30px;
    }

    .def-dist-length span{
      font-size:13px;
    }

    .def-dist-tablewrap{ overflow-x:auto; }
    table.def-dist-table{
      width:100%;
      border-collapse:separate;
      border-spacing:0;
      background:#fff;
      border:1px solid #e5e5e5;
      border-radius:12px;
      overflow:hidden;
      font-size:15px;
    }

    .def-dist-table thead th{
      text-align:left;
      font-weight:600;
      padding:10px 12px;
      border-bottom:1px solid #e8e8e8;
      position:relative;
      user-select:none;
      cursor:pointer;
      white-space:nowrap;
      background:#fafafa;
    }

    .def-dist-table tbody td{
      padding:8px 12px;
      border-bottom:1px solid #f0f0f0;
      white-space:nowrap;
    }

    .def-dist-table tbody tr:last-child td{ border-bottom:none; }

    /* Sort icon (single arrow that flips) */
    .def-dist-sort{
      display:inline-block;
      width:12px;
      margin-left:8px;
      opacity:.55;
      vertical-align:middle;
      position:relative;
      top:-1px;
    }

    .def-dist-sort:before{
      content:"↕";
      font-size:12px;
    }

    /* When sorted, show one direction */
    th.def-dist-sorted-asc .def-dist-sort:before{
      content:"▲";
      opacity:1;
    }

    th.def-dist-sorted-desc .def-dist-sort:before{
      content:"▼";
      opacity:1;
    }
    
    /* Pagination */
    .def-dist-pagination{
      display:flex;
      gap:6px;
      align-items:center;
      flex-wrap:wrap;
    }

    .def-dist-pagebtn{
      padding:5px 8px;
      min-width:30px;
      font-size:13px;
      border:1px solid #e0e0e0;
      background:#fff;
      border-radius:8px;
      cursor:pointer;
      text-align:center;
    }

    .def-dist-pagebtn[aria-current="page"]{
      border-color:#000;
      font-weight:600;
    }

    .def-dist-pagebtn[disabled]{
      opacity:.4;
      cursor:not-allowed;
    }

    .def-dist-info{
      color:#666;
      font-size:14px;
    }
	  
    @media (max-width: 768px) {
      .def-dist-table tbody td:first-child {
        font-weight: 600;
        background: #f7f7f7;
        border-right: 1px solid #e5e5e5;
      }
    }
  </style>
  <link rel="icon" href="https://www.defianceetfs.com/wp-content/uploads/2021/03/cropped-symbol-dark_Favicon-150x150.png" sizes="32x32" />
<link rel="icon" href="https://www.defianceetfs.com/wp-content/uploads/2021/03/cropped-symbol-dark_Favicon-300x300.png" sizes="192x192" />
<link rel="apple-touch-icon" href="https://www.defianceetfs.com/wp-content/uploads/2021/03/cropped-symbol-dark_Favicon-300x300.png" />
<meta name="msapplication-TileImage" content="https://www.defianceetfs.com/wp-content/uploads/2021/03/cropped-symbol-dark_Favicon-300x300.png" />

    <!-- BEGIN - Make Tables Responsive -->
    <style type="text/css">
        
    /* Multi-row tables */
    @media (max-width: 767px) {

        .mtr-table tbody,
        .mtr-table {
        	width: 100% !important;
            display: table !important;
        }

        .mtr-table tr,
        .mtr-table .mtr-th-tag,
        .mtr-table .mtr-td-tag {
        	display: block !important;
            clear: both !important;
            height: auto !important;
        }

        .mtr-table .mtr-td-tag,
        .mtr-table .mtr-th-tag {
        	text-align: right !important;
            width: auto !important;
            box-sizing: border-box !important;
            overflow: auto !important;
        }
    
            .mtr-table .mtr-cell-content {
            	text-align: left !important;
                width: 100%;
                padding-left: 6px;
                box-sizing: border-box;
            }
            
        .mtr-table td[data-mtr-content]:before,
        .mtr-table th[data-mtr-content]:before {
        	display: inline-block !important;
        	content: attr(data-mtr-content) !important;
        	float: left !important;
            text-align: left !important;
            white-space: pre-line !important;
        }
        
        .mtr-table thead,
        .mtr-table.mtr-tr-th tr:first-of-type,
        .mtr-table.mtr-tr-td tr:first-of-type,
        .mtr-table colgroup {
        	display: none !important;
        }
    
        .mtr-table tfoot {
        	display: none !important;
        }
        
        .mtr-cell-content {
            max-width: 40% !important;
            display: inline-block !important;
        }
            
        .mtr-table td[data-mtr-content]:before,
        .mtr-table th[data-mtr-content]:before {
            max-width: 60% !important;
        }
            
    }
    
    /* Single-row tables */
    @media (max-width: 650px) {

        .mtr-one-row-table .mtr-td-tag,
        .mtr-one-row-table .mtr-th-tag {
            box-sizing: border-box !important;
        }

        .mtr-one-row-table colgroup {
        	display: none !important;
        }

    
        .mtr-one-row-table .mtr-td-tag,
        .mtr-one-row-table .mtr-th-tag {
        	display: inline-block !important;
        }
        
    }
    </style>
    <!-- END - Make Tables Responsive -->
        

	
</head>
<style>
    body.home .menu-item.current-menu-item{
        display: none;
    }
    .footer-logo {
        background-image: url('https://dev.kllr.design/defiance/wp-content/uploads/2020/12/header-logo-white.svg');
    }
    .menu-item-has-children > a {
        position: relative;
        display: inline-block;
    }
    .sub-menu{
        display: none;
        position: absolute;
        background: #1F2127;
        min-width: 102px;
        width: auto;
        z-index: 1;
        padding: 20px;
        box-shadow: 2px 2px 25px rgba(0, 0, 0, 0.1);
        border-radius: 16px;
        top: calc(100% + 15px);
        right: 0;
    }
    .light-header .sub-menu,
    .sticked .sub-menu {
        background: #fff;
    }
    .dark.sticked .sub-menu{
        background: #1F2127;
    }
    .light.sticked .menu-item:not(.menu-item-36) .sub-menu li:hover {
        background-color: #F7F7FC;
    }
    .light .nav-etf-header:hover {
        color: #1F2127;
    }
    .sub-menu li{
        margin: 0 0 16px 0;
        width: 100%;
        padding: 0;
    }
    .sub-menu li:not(.menu-item-object-etf):hover{
        background-color: #282B35;
    }
    .light-header .sub-menu li:hover{
        background: #F7F7FC;
    }
   /* .menu-item-has-children:hover .sub-menu,*/
    .menu-item-has-children:focus .sub-menu,
    .menu-item-has-children.active .sub-menu {
        display: block;
    }
    .single-etf .header.sticky.sticked.dark .header-logo.with_small {
        background-image: url('https://dev.kllr.design/defiance/wp-content/uploads/2020/12/header-logo-d.svg');
    }
    .header .header-logo,
    .header.dark .header-logo{
        background-image: url('https://www.defianceetfs.com/wp-content/uploads/2022/10/logo.svg');
    }
    .header.light-header .header-logo,
    .header.light .header-logo{
        background-image: url('https://www.defianceetfs.com/wp-content/uploads/2022/10/etfs-logo-dark.svg');
    }
    .menu-item-1431{
        display: none;
    }
    .nav-etf-header{
        display: flex;
        justify-content: flex-start;
        color: #B4BDCB;
        transition: color 300ms linear ;
    }
    .nav-etf-header:hover
    {
        color: #6943FF;
    }
    .insert-to-nav{
        margin-left: 15px;
    }
    /*.menu-item.navETFHolder:hover .sub-menu, */
    .menu-item.navETFHolder:focus .sub-menu,
    .menu-item.navETFHolder.active .sub-menu{
        display: flex;
    }
  /*  .menu-item.navETFHolder .bg{
        background-image: url(https://via.placeholder.com/220x251);
        width: 220px;
        height: auto;
        background-position: center;
        background-repeat: no-repeat;
    }*/
    .menu-item.navETFHolder .list{
        width: 100%;
        display: block;
    }
    .menu-item.navETFHolder .sub-menu {
        padding: 20px 20px 20px 32px;
        min-width: 350px;
        justify-content: space-between;
    }
    #header-etf-img{
        flex: 0 0 220px;
    }
    #header-etf-img im{
        flex: 0 0 220px;
    }
    .insert-img-nav{
        transition: opacity 300ms linear;
        position: absolute;
    }
    .collapseEtfs{
        display: flex;
        background-repeat: no-repeat;
        background-position-x: right;
        background-position-y: center;
    }
    .collapseEtfs:hover{
        color: inherit;
    }
    .collapse .header-menu{
        padding-left: 20px;
    }
    .blue-gradient{
        background: linear-gradient(
                80.92deg , #4374ff 12.04%, #8bb3ef 91.48%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .collapseEtfs[aria-expanded="true"]{
        color: inherit;
        background-image: url("data:image/svg+xml,%3Csvg width='16' height='3' viewBox='0 0 16 3' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 0.393188H16V2.39319H0V0.393188Z' fill='%230500F0'/%3E%3C/svg%3E%0A");
    }
    .header.sticky.light .collapseEtfs[aria-expanded="false"]{
        background-image: url("data:image/svg+xml,%3Csvg width='16' height='17' viewBox='0 0 16 17' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 7.5H16V9.5H0V7.5Z' fill='%23000000'/%3E%3Cpath d='M7 16.5V0.5H9V16.5H7Z' fill='%23000000'/%3E%3C/svg%3E%0A");
    }

    .header.sticky.dark .collapseEtfs[aria-expanded="false"]{
        background-image: url("data:image/svg+xml,%3Csvg width='16' height='17' viewBox='0 0 16 17' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 7.5H16V9.5H0V7.5Z' fill='%23F2F2F2'/%3E%3Cpath d='M7 16.5V0.5H9V16.5H7Z' fill='%23F2F2F2'/%3E%3C/svg%3E%0A");
    }

    @media (min-width: 992px){
        .collapseEtfs{
            display: none;
        }
        .single-etf .header .header-logo {
            background-image: url('https://www.defianceetfs.com/wp-content/uploads/2022/10/logo.svg');
        }
        .single-etf .header.light-header .header-logo {
            background-image: url('https://www.defianceetfs.com/wp-content/uploads/2022/10/etfs-logo-dark.svg');
        }
    }
    @media (max-width: 992px){
        #menu-primary-menu{
            width: 100%;
            margin-right: 0;
        }

        .menu-item.menu-item-has-children:not(.navETFHolder) .sub-menu{
            position: relative;
            box-shadow: none;
            padding: 20px 0 0 calc(2rem - 20px);
            background: transparent;
        }

        .menu-item.menu-item-has-children:not(.navETFHolder) > a,
        .menu-item.menu-item-has-children:not(.navETFHolder).open.hidden > a {
            background-image: url("data:image/svg+xml,%3Csvg width='16' height='17' viewBox='0 0 16 17' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 7.5H16V9.5H0V7.5Z' fill='%23000000'/%3E%3Cpath d='M7 16.5V0.5H9V16.5H7Z' fill='%23000000'/%3E%3C/svg%3E%0A");
            background-repeat: no-repeat;
            background-position-x: calc(100% - 20px);
            background-position-y: center;
            padding-right: 20px;
            width: 100%;
        }

        .menu-item.menu-item-has-children:not(.navETFHolder):hover > a,
        .header.sticky.dark .menu-item.menu-item-has-children:not(.navETFHolder):hover > a,
        .menu-item.menu-item-has-children:not(.navETFHolder).open > a,
        .header.sticky.dark .menu-item.menu-item-has-children:not(.navETFHolder).open > a,
        .menu-item.menu-item-has-children:not(.navETFHolder).active > a,
        .header.sticky.dark .menu-item.menu-item-has-children:not(.navETFHolder).active > a {
            color: inherit;
            background-image: url("data:image/svg+xml,%3Csvg width='16' height='3' viewBox='0 0 16 3' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 0.393188H16V2.39319H0V0.393188Z' fill='%230500F0'/%3E%3C/svg%3E%0A");
        }
        .header.sticky.dark .menu-item.menu-item-has-children:not(.navETFHolder) > a,
        .header.sticky.dark .menu-item.menu-item-has-children:not(.navETFHolder).open.hidden > a{
            background-image: url("data:image/svg+xml,%3Csvg width='16' height='17' viewBox='0 0 16 17' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 7.5H16V9.5H0V7.5Z' fill='%23F2F2F2'/%3E%3Cpath d='M7 16.5V0.5H9V16.5H7Z' fill='%23F2F2F2'/%3E%3C/svg%3E%0A");
        }

        .menu-item.menu-item-has-children:not(.navETFHolder) .sub-menu li {
            margin: 0 0 12px 12px;
        }
        .menu-item.menu-item-has-children:not(.navETFHolder) .sub-menu li a {
            font-weight: 600;
            font-size: 18px;
            line-height: 160%;
            letter-spacing: 0.02em;
            font-family: 'Surt', sans-serif;
        }

        .menu-item-home,
        .insert-to-nav{
            display: none;
        }
        .header-menu li{
            margin: 0;
        }
        .menu-open #spac-alerts {
            display: block;
            position: absolute;
            top: auto;
            bottom: 0;
            width: 100%;
            border-radius: 0;
            left: 0;
            height: 56px;
            z-index: 9999;
        }
        .menu-item-1431 {
            display: block;
        }
        .header-menu-wrp {
            text-align: left;
            align-items: flex-start;
        }
        .menu-open .header-menu-wrp {
            height:auto;
            overflow-y: auto;
            min-height: -webkit-fill-available;
            padding-top: 73px;
            padding-bottom: 20px;
        }
        .header-menu-wrp a{
            font-weight: 600;
            font-size: 22px;
            line-height: 160%;
            letter-spacing: 0.02em;
        }

        .menu-item.navETFHolder{
            display: none;
        }
        .header .header-logo {
            width: 216px;
            height: 25px;
            top: 16px;
        }
        .single-etf .header .header-logo {
            background-image: url('https://dev.kllr.design/defiance/wp-content/uploads/2020/12/header-logo-d.svg');
        }
    }
    @media (max-width: 425px){
        .header .header-logo {
            width: 198px;
            background-size: contain;
            top: 12px;
        }
    }


</style>


<body class="wp-singular page-template page-template-page-etf-holdings page-template-page-etf-holdings-php page page-id-8228 wp-custom-logo wp-theme-definance mega-menu-menu-1 no-sidebar">
	
	
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://gtm.defianceetfs.com/ns.html?id=GTM-TTRP4KR"
                  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->





<header class="header light light-header  sticky ">
    <div class="container">
        <a href="https://www.defianceetfs.com" class="header-logo "></a>
        
        <div class="header-menu-wrp">
            
               

            
                            <div id="mega-menu-wrap-menu-1" class="mega-menu-wrap"><div class="mega-menu-toggle"><div class="mega-toggle-blocks-left"><div class='mega-toggle-block mega-menu-toggle-block mega-toggle-block-1' id='mega-toggle-block-1'><button aria-controls="mega-menu-menu-1" aria-expanded="false" aria-haspopup="true" class='mega-toggle-standard mega-toggle-label'><span class='mega-toggle-label-closed'></span><span class='mega-toggle-label-open'></span></button></div></div><div class="mega-toggle-blocks-center"></div><div class="mega-toggle-blocks-right"></div></div><ul id="mega-menu-menu-1" class="mega-menu max-mega-menu mega-menu-horizontal mega-no-js" data-event="hover_intent" data-effect="fade_up" data-effect-speed="200" data-effect-mobile="slide" data-effect-speed-mobile="200" data-mobile-force-width="body" data-second-click="go" data-document-click="collapse" data-vertical-behaviour="standard" data-breakpoint="768" data-unbind="true" data-mobile-state="collapse_all" data-mobile-direction="vertical"><li class="mega-menu-item mega-menu-item-type-custom mega-menu-item-object-custom mega-menu-item-has-children mega-menu-megamenu mega-menu-grid mega-align-bottom-left mega-menu-item-36" id="mega-menu-item-36"><a class="mega-menu-link" href="/explore-our-etfs" aria-expanded="false" aria-controls="mega-sub-menu-36">ETFs<span class="mega-indicator" aria-hidden="true"></span></a>
<ul class="mega-sub-menu" role='presentation' id='mega-sub-menu-36'>
<li class="mega-menu-row" id="mega-menu-36-0">
	<ul class="mega-sub-menu" style='--columns:12' role='presentation'>
<li class="mega-menu-column mega-menu-columns-12-of-12" style="--columns:12; --span:12" id="mega-menu-36-0-0">
		<ul class="mega-sub-menu">
<li class="mega-menu-item mega-menu-item-type-widget widget_maxmegamenu_reusable_block mega-menu-item-maxmegamenu_reusable_block-2" id="mega-menu-item-maxmegamenu_reusable_block-2"><div class="etf-menu">

  <!-- Search bar -->
  <div class="etf-menu-search">
    <svg class="etf-menu-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input type="text" class="etf-menu-search-input" placeholder="Search by ticker or fund name..." aria-label="Search ETFs">
    <button type="button" class="etf-menu-search-clear" aria-label="Clear search">×</button>
  </div>

  <!-- Tabs -->
  <div class="etf-menu-tabs">
    <button class="etf-tab active" data-tab="featured">Featured</button>
    <button class="etf-tab" data-tab="thematic">Thematic</button>
    <button class="etf-tab" data-tab="leveraged-long">Leveraged Long</button>
    <button class="etf-tab" data-tab="leveraged-short">Leveraged Short</button>
    <button class="etf-tab" data-tab="income">Income</button>
    <!-- New tab hidden for now — remove style="display:none" to re-enable -->
    <button class="etf-tab" data-tab="new" style="display:none">New</button>
  </div>

  <!-- Search results (populated by JS when searching) -->
  <div class="etf-menu-search-results" hidden="">
    <div class="etf-menu-empty">No ETFs match your search.</div>
  </div>

  <!-- Tab panels (populated by JS on load) -->
  <div class="etf-menu-panels">
    <div class="etf-panel active" data-panel="featured"></div>
    <div class="etf-panel" data-panel="thematic"></div>
    <div class="etf-panel" data-panel="leveraged-long"></div>
    <div class="etf-panel" data-panel="leveraged-short"></div>
    <div class="etf-panel" data-panel="income"></div>
    <div class="etf-panel" data-panel="new"></div>
  </div>

  <!-- Buttons -->
  <div class="etf-menu-actions">
    <a href="/wp-content/uploads/funddocs/ETF_ProductGuide.pdf" class="etf-action-link">Product Guide <span class="etf-action-arrow">→</span></a>
    <a href="/fund-documents" class="etf-action-link">Materials <span class="etf-action-arrow">→</span></a>
<a href="/explore-our-etfs" class="etf-action-link">Explore All ETFs<span class="etf-action-arrow">→</span></a>
  </div>

</div>

<script>
(function() {
  document.addEventListener('DOMContentLoaded', function() {

    var menu = document.querySelector('.etf-menu');
    if (!menu) return;

    var CONFIG = {
      endpoint: '/wp-json/defiance/v1/etfs-explore'
    };

    var SHARED = window.DefianceETFData || {};
    var CATEGORY_LABELS = SHARED.categoryLabels || {
      'leveraged-long': 'Leveraged Long',
      'leveraged-short': 'Leveraged Short',
      'thematic': 'Thematic',
      'income': 'Income'
    };

    var FEATURED_TICKERS = [
        { ticker: 'QTUM', name: 'Quantum ETF',                     url: 'https://www.defianceetfs.com/qtum/' },
       { ticker: 'CAPA', name: 'Capacitor & MLCC ETF', url: 'https://www.defianceetfs.com/capa/' },
       { ticker: 'QTUP', name: 'Pure Quantum ETF', url: 'https://www.defianceetfs.com/qtup/' },
       { ticker: 'UFOX', name: 'Space & Connective Tech ETF', url: 'https://www.defianceetfs.com/ufox/' },
       { ticker: 'CROB', name: 'China Robotics ETF', url: 'https://www.defianceetfs.com/crob/' },
       { ticker: 'AINF', name: 'Inference AI Chip ETF', url: 'https://www.defianceetfs.com/ainf/' },
       { ticker: 'PRAM', name: 'Memory & Photonics ETF', url: 'https://www.defianceetfs.com/pram/' },
       { ticker: 'AIPO', name: 'AI & Power Infrastructure ETF', url: 'https://www.defianceetfs.com/aipo/' },
       { ticker: 'AIHY', name: 'AI Hyperscale Leaders ETF', url: 'https://www.defianceetfs.com/aihy/' },
       { ticker: 'XMAG', name: 'Large Cap ex-Mag 7 ETF', url: 'https://www.defianceetfs.com/xmag/' },
       { ticker: 'JEDI', name: 'Drone & Modern Warfare ETF', url: 'https://www.defianceetfs.com/jedi/' },
     
];
    // Terms excluded from search matching
    var SEARCH_STOPWORDS = ['daily', 'target', '2x', 'long', 'short'];
    var STOPWORD_RE = new RegExp(
      '\\b(' + SEARCH_STOPWORDS.map(function(w){ return w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }).join('|') + ')\\b',
      'gi'
    );

    function isRecentlyLaunched(etf) {
      return etf.secYield === null || etf.secYield === undefined || etf.secYield === '';
    }

    var allEtfs = [];

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, function(c) {
        return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
      });
    }

    function cleanName(name) {
      return String(name).replace(/^Defiance\s+/i, '');
    }

    function renderListItem(etf) {
      return '<li><a href="' + escapeHtml(etf.url) + '">' +
             '<span class="etf-ticker">' + escapeHtml(etf.ticker) + '</span>' +
             '<span class="etf-name">' + escapeHtml(cleanName(etf.name)) + '</span>' +
             '</a></li>';
    }

    function renderList(etfs) {
      return '<ul class="etf-list">' + etfs.map(renderListItem).join('') + '</ul>';
    }

    function renderListGrid(etfs) {
      return '<ul class="etf-list etf-list-grid">' + etfs.map(renderListItem).join('') + '</ul>';
    }

    function sortByAum(a, b) {
      var av = a.netAssets, bv = b.netAssets;
      var ae = av === null || av === undefined || av === '';
      var be = bv === null || bv === undefined || bv === '';
      if (ae && be) return 0;
      if (ae) return 1;
      if (be) return -1;
      return parseFloat(bv) - parseFloat(av);
    }

    function populatePanels(root) {
      // Featured — hardcoded tickers, always shown first
      var featuredPanel = root.querySelector('.etf-panel[data-panel="featured"]');
      if (featuredPanel) {
        featuredPanel.innerHTML = renderList(FEATURED_TICKERS);
      }

      ['thematic', 'leveraged-long', 'leveraged-short', 'income'].forEach(function(cat) {
        var inCategory = allEtfs.filter(function(e) { return e.category === cat; });

        if (cat === 'leveraged-long') {
          var pinned = ['SPCU', 'SPCL'];
          var pinnedEtfs = [];
          pinned.forEach(function(ticker) {
            var match = inCategory.find(function(e) { return e.ticker === ticker; });
            if (match) pinnedEtfs.push(match);
          });
          var rest = inCategory.filter(function(e) { return pinned.indexOf(e.ticker) === -1; });
          rest.sort(sortByAum);
          inCategory = pinnedEtfs.concat(rest);
        } else {
          inCategory.sort(sortByAum);
        }

        var panel = root.querySelector('.etf-panel[data-panel="' + cat + '"]');
        if (!panel) return;

        if (cat === 'leveraged-long' || cat === 'leveraged-short') {
          panel.innerHTML = renderListGrid(inCategory);
        } else {
          panel.innerHTML = renderList(inCategory);
        }
      });

      // New = funds with no 30-day SEC yield yet (proxy for ~1 month since launch)
      var newEtfs = allEtfs.filter(isRecentlyLaunched).sort(sortByAum);
      var newPanel = root.querySelector('.etf-panel[data-panel="new"]');
      if (newPanel) {
        newPanel.innerHTML = newEtfs.length
          ? renderList(newEtfs)
          : '<div class="etf-menu-empty">No recent launches right now.</div>';
      }
    }

    function initMenuRoot(root) {
      var tabs = root.querySelectorAll('.etf-tab');
      var panels = root.querySelectorAll('.etf-panel');
      var searchInput = root.querySelector('.etf-menu-search-input');
      var searchClear = root.querySelector('.etf-menu-search-clear');
      var searchResults = root.querySelector('.etf-menu-search-results');
      var panelsContainer = root.querySelector('.etf-menu-panels');
      var tabsContainer = root.querySelector('.etf-menu-tabs');

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          var tabId = tab.getAttribute('data-tab');
          tabs.forEach(function(t) { t.classList.remove('active'); });
          panels.forEach(function(p) { p.classList.remove('active'); });
          tab.classList.add('active');
          var panel = root.querySelector('.etf-panel[data-panel="' + tabId + '"]');
          if (panel) panel.classList.add('active');
        });
      });

      function renderSearchResults(query) {
        query = query.trim().toLowerCase();
        if (!query) {
          searchResults.hidden = true;
          panelsContainer.style.display = '';
          tabsContainer.style.display = '';
          return;
        }
        panelsContainer.style.display = 'none';
        tabsContainer.style.display = 'none';
        searchResults.hidden = false;

        // Search across live ETFs + featured tickers
        var combined = allEtfs.slice();
        FEATURED_TICKERS.forEach(function(ft) {
          var alreadyIn = combined.some(function(e) { return e.ticker === ft.ticker; });
          if (!alreadyIn) combined.push({ ticker: ft.ticker, name: ft.name, url: ft.url, category: 'featured', netAssets: null, secYield: null });
        });

        var matches = combined.filter(function(e) {
          var hay = (e.ticker + ' ' + e.name)
            .toLowerCase()
            .replace(STOPWORD_RE, ' ')
            .replace(/\s+/g, ' ')
            .trim();
          return hay.indexOf(query) !== -1;
        });

        if (matches.length === 0) {
          searchResults.innerHTML = '<div class="etf-menu-empty">No ETFs match "<strong>' + escapeHtml(query) + '</strong>".</div>';
          return;
        }

        var byCategory = {};
        matches.forEach(function(m) {
          var cat = m.category === 'featured' ? 'featured' : m.category;
          if (!byCategory[cat]) byCategory[cat] = [];
          byCategory[cat].push(m);
        });

        var categoryOrder = ['featured', 'thematic', 'leveraged-long', 'leveraged-short', 'income'];
        var categoryNames = Object.assign({ 'featured': 'Featured' }, CATEGORY_LABELS);

        var html = '';
        categoryOrder.forEach(function(cat) {
          if (!byCategory[cat]) return;
          byCategory[cat].sort(sortByAum);
          html += '<div class="etf-panel-section">';
          html += '<h4 class="etf-panel-eyebrow">' + categoryNames[cat] + '</h4>';
          html += renderList(byCategory[cat]);
          html += '</div>';
        });
        searchResults.innerHTML = html;
      }

      var debounceTimer;
      searchInput.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        var query = searchInput.value;
        root.classList.toggle('is-searching', query.trim().length > 0);
        debounceTimer = setTimeout(function() { renderSearchResults(query); }, 100);
      });
      searchClear.addEventListener('click', function() {
        searchInput.value = '';
        root.classList.remove('is-searching');
        renderSearchResults('');
        searchInput.focus();
      });
      searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && searchInput.value) {
          searchInput.value = '';
          root.classList.remove('is-searching');
          renderSearchResults('');
        }
      });
    }

    fetch(CONFIG.endpoint)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        allEtfs = data.map(function(etf) {
          return {
            ticker: etf.ticker,
            name: etf.name,
            url: etf.url,
            netAssets: etf.net_assets,
            secYield: etf.sec_yield_subsidized,
            category: etf.category || 'other'
          };
        });

        populatePanels(menu);
        initMenuRoot(menu);

        var mobileOverlay = document.createElement('div');
        mobileOverlay.className = 'etf-mobile-overlay';
        mobileOverlay.setAttribute('aria-hidden', 'true');
        mobileOverlay.innerHTML =
          '<div class="etf-mobile-backdrop"></div>' +
          '<div class="etf-mobile-sheet">' +
            '<div class="etf-mobile-header">' +
              '<span class="etf-mobile-title">Our ETFs</span>' +
              '<button type="button" class="etf-mobile-close" aria-label="Close menu">' +
                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
              '</button>' +
            '</div>' +
            '<div class="etf-mobile-body"></div>' +
          '</div>';
        document.body.appendChild(mobileOverlay);

        var mobileBody = mobileOverlay.querySelector('.etf-mobile-body');
        var menuClone = menu.cloneNode(true);
        menuClone.classList.add('etf-menu-mobile');
        mobileBody.appendChild(menuClone);

        populatePanels(menuClone);
        initMenuRoot(menuClone);

        function openMobile() {
          mobileOverlay.classList.add('is-open');
          mobileOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }
        function closeMobile() {
          mobileOverlay.classList.remove('is-open');
          mobileOverlay.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        mobileOverlay.querySelector('.etf-mobile-close').addEventListener('click', closeMobile);
        mobileOverlay.querySelector('.etf-mobile-backdrop').addEventListener('click', closeMobile);

        mobileOverlay.querySelectorAll('a').forEach(function(a) {
          a.addEventListener('click', function() {
            setTimeout(closeMobile, 50);
          });
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && mobileOverlay.classList.contains('is-open')) {
            closeMobile();
          }
        });

        function isMobileScreen() {
          return window.matchMedia('(max-width: 768px)').matches;
        }

        function isEtfsNavLink(el) {
          if (!el || el.tagName !== 'A') return false;
          var text = (el.textContent || '').trim();
          if (text !== 'ETFs' && text !== 'Etfs' && text !== 'ETF') return false;
          var inNav = el.closest('header, nav, .mega-menu, #mega-menu-wrap-menu-1, .header-menu-wrp, [class*="menu"], [id*="menu"]');
          return !!inNav;
        }

        function handleNavClick(e) {
          if (!isMobileScreen()) return;
          var link = e.target.closest('a');
          if (!link) return;
          if (!isEtfsNavLink(link)) return;
          e.preventDefault();
          e.stopPropagation();
          if (e.stopImmediatePropagation) e.stopImmediatePropagation();
          openMobile();
        }

        document.addEventListener('click', handleNavClick, true);
        document.addEventListener('touchend', handleNavClick, true);

        function syncDesktopVisibility() {
          if (isMobileScreen()) {
            menu.style.display = 'none';
          } else {
            menu.style.display = '';
            closeMobile();
          }
        }
        syncDesktopVisibility();
        window.addEventListener('resize', syncDesktopVisibility);
      })
      .catch(function(err) {
        console.error('ETF menu load error:', err);
        menu.querySelectorAll('.etf-panel').forEach(function(p) {
          p.innerHTML = '<div class="etf-menu-empty">Unable to load ETFs. Please refresh the page.</div>';
        });
      });
  });
})();
</script>

<style>
/* ============================================================
   DEFIANCE ETF MEGA MENU
   Desktop dropdown + custom mobile full-screen overlay
   Aligned to brand guide
   ============================================================ */

.etf-menu {
  font-family: 'Surt', sans-serif;
  max-width: 100%;
  width: 100%;
  background: #fff;
  color: #0a0a0a;
  padding: 8px;
}

/* === SEARCH BAR === */
.etf-menu-search {
  position: relative;
  margin-bottom: 16px;
}
.etf-menu-search-input {
  width: 100%;
  padding: 12px 40px 12px 44px;
  border: 1px solid rgba(0,0,0,0.1);
  border-radius: 8px;
  background: #f7f7fd;
  font-family: 'Surt', sans-serif;
  font-size: 15px;
  color: #0a0a0a;
  outline: none;
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  box-sizing: border-box;
}
.etf-menu-search-input::placeholder {
  color: rgba(0,0,0,0.4);
  font-weight: 400;
}
.etf-menu-search-input:focus {
  border-color: #2438e8;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(36, 56, 232, 0.12);
}
.etf-menu-search-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  width: 18px;
  height: 18px;
  color: rgba(0,0,0,0.4);
  pointer-events: none;
}
.etf-menu-search-clear {
  position: absolute;
  right: 8px;
  top: 50%;
  transform: translateY(-50%);
  width: 26px;
  height: 26px;
  border: none;
  background: rgba(0,0,0,0.08);
  border-radius: 50%;
  color: #0a0a0a;
  font-size: 16px;
  line-height: 1;
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s, background 0.2s;
  font-family: Arial, sans-serif;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.etf-menu.is-searching .etf-menu-search-clear,
.etf-menu-mobile.is-searching .etf-menu-search-clear {
  opacity: 1;
  pointer-events: auto;
}
.etf-menu-search-clear:hover {
  background: rgba(0,0,0,0.15);
}

/* === TABS === */
.etf-menu-tabs {
  display: flex;
  gap: 4px;
  margin-bottom: 16px;
  border-bottom: 1px solid rgba(0,0,0,0.08);
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.etf-menu-tabs::-webkit-scrollbar { display: none; }
.etf-tab {
  padding: 10px 16px;
  border: none;
  background: transparent;
  font-family: 'Surt', sans-serif;
  font-size: 11px;
  font-weight: 600;
  color: rgba(0,0,0,0.55);
  cursor: pointer;
  border-radius: 0;
  white-space: nowrap;
  position: relative;
  transition: color 0.2s;
  flex-shrink: 0;
}
.etf-tab::after {
  content: "";
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background: transparent;
  transition: background 0.2s;
}
.etf-tab:hover { color: #0a0a0a; }
.etf-tab.active { color: #2438e8; }
.etf-tab.active::after { background: #2438e8; }

/* === PANELS === */
.etf-menu-panels { position: relative; }
.etf-panel { display: none; }
.etf-panel.active { display: block; }

.etf-panel[data-panel="featured"].active {
  display: block;
  max-height: none;
}

.etf-panel[data-panel="featured"].active .etf-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0 12px;
}

.etf-list-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0 4px;
  max-height: 260px;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.etf-panel:not([data-panel="featured"]) .etf-list:not(.etf-list-grid) {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0 12px;
  max-height: none;
}

.etf-panel-section { margin-bottom: 0; }
.etf-panel-eyebrow {
  font-family: 'Surt-Exp', sans-serif;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: #2438e8;
  margin: 0 0 8px 0;
  padding: 0 8px;
}

/* === LIST === */
.etf-list {
  list-style: none;
  margin: 0;
  padding: 0;
}
.etf-list li { margin: 0; }
.etf-list li a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 4px;
  text-decoration: none;
  color: inherit;
  border-radius: 6px;
  transition: background 0.15s;
  position: relative;
}
.etf-list li a:hover {
  background: rgba(36, 56, 232, 0.05);
}
.etf-list li a:hover .etf-name {
  color: #2438e8;
}
.etf-ticker {
  display: inline-block;
  font-family: 'Surt-Exp', sans-serif;
  font-weight: 800;
  font-size: 11px;
  color: #fff;
  background: linear-gradient(135deg, #2438e8 0%, #3b50f5 100%);
  letter-spacing: 1px;
  padding: 4px 10px;
  border-radius: 100px;
  min-width: 64px;
  text-align: center;
  flex-shrink: 0;
  line-height: 1.3;
}
.etf-name {
  font-family: 'Surt', sans-serif;
  font-size: 11px;
  color: rgba(10,10,10,0.75);
  font-weight: 500;
  line-height: 1.3;
  flex: 1;
  transition: color 0.15s;
}

/* === SEARCH RESULTS === */
.etf-menu-search-results {
  padding: 0;
  max-height: 400px;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.etf-menu-empty {
  font-family: 'Surt', sans-serif;
  padding: 32px 16px;
  text-align: center;
  color: rgba(0,0,0,0.55);
  font-size: 16px;
}
.etf-menu-empty strong { color: #0a0a0a; }

/* === ACTION BUTTONS === */
.etf-menu-actions {
  display: flex;
  gap: 28px;
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid rgba(0,0,0,0.06);
}
.etf-action-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 0;
  color: #0a0a0a;
  text-decoration: none;
  font-family: 'Surt', sans-serif;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.2px;
  transition: color 0.2s, gap 0.25s;
}
.etf-action-link:hover {
  color: #2438e8;
  gap: 10px;
}
.etf-action-arrow {
  display: inline-block;
  font-size: 14px;
  color: #2438e8;
  transition: transform 0.25s;
}
.etf-action-link:hover .etf-action-arrow {
  transform: translateX(2px);
}

/* === MEGA MENU PLUGIN OVERRIDES (DESKTOP) === */
#mega-menu-wrap-menu-1 #mega-menu-menu-1 > li.mega-menu-megamenu > ul.mega-sub-menu,
.mega-menu-megamenu > ul.mega-sub-menu {
  box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.18) !important;
  background: #fff !important;
  border: 1px solid rgba(0,0,0,0.06) !important;
  border-radius: 14px !important;
  padding: 24px !important;
  z-index: 999 !important;
  position: absolute !important;
  width: 820px !important;
  max-width: 820px !important;
  right: 0 !important;
  left: auto !important;
  transform: none !important;
  overflow: hidden !important;
  box-sizing: border-box !important;
}

.mega-sub-menu .etf-menu {
  max-width: 100%;
  width: 100%;
  padding: 0;
}

@media (max-width: 1024px) and (min-width: 769px) {
  #mega-menu-wrap-menu-1 #mega-menu-menu-1 > li.mega-menu-megamenu > ul.mega-sub-menu,
  .mega-menu-megamenu > ul.mega-sub-menu {
    width: calc(100vw - 32px) !important;
    max-width: calc(100vw - 32px) !important;
  }
}

/* ============================================================
   MOBILE FULL-SCREEN OVERLAY
   ============================================================ */

@media (max-width: 768px) {
  #mega-menu-wrap-menu-1 #mega-menu-menu-1 > li.mega-menu-megamenu > ul.mega-sub-menu {
    display: none !important;
  }
}

.etf-mobile-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999999;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.25s ease;
  display: none;
}

@media (max-width: 768px) {
  .etf-mobile-overlay { display: block; }
}

.etf-mobile-overlay.is-open {
  pointer-events: auto;
  opacity: 1;
}

.etf-mobile-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
}

.etf-mobile-sheet {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  flex-direction: column;
  transform: translateY(-100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}

.etf-mobile-overlay.is-open .etf-mobile-sheet {
  transform: translateY(0);
}

.etf-mobile-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid rgba(0,0,0,0.08);
  flex-shrink: 0;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 2;
}
.etf-mobile-title {
  font-family: 'Surt-Exp', sans-serif;
  font-size: 20px;
  font-weight: 700;
  color: #0a0a0a;
  letter-spacing: -0.02em;
}
.etf-mobile-close {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: none;
  background: #0a0a0a;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 0;
  transition: background 0.15s, transform 0.15s;
  flex-shrink: 0;
}
.etf-mobile-close:hover,
.etf-mobile-close:active {
  background: #2438e8;
  transform: scale(1.05);
}
.etf-mobile-close svg {
  width: 22px;
  height: 22px;
  stroke: #fff;
}

.etf-mobile-body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 16px 20px 32px;
}

.etf-menu-mobile {
  padding: 0;
  width: 100%;
}

.etf-menu-mobile .etf-menu-search {
  margin-bottom: 16px;
}
.etf-menu-mobile .etf-menu-search-input {
  font-size: 16px;
  padding: 14px 44px 14px 46px;
}

.etf-menu-mobile .etf-menu-tabs {
  margin-left: -20px;
  margin-right: -20px;
  padding-left: 20px;
  padding-right: 20px;
  position: sticky;
  top: -16px;
  background: #fff;
  z-index: 1;
  margin-bottom: 20px;
}

.etf-menu-mobile .etf-tab {
  padding: 12px 14px;
  font-size: 11px;
}

.etf-menu-mobile .etf-panel[data-panel="featured"].active {
  display: block;
  max-height: none;
  overflow: visible;
}

.etf-menu-mobile .etf-list-grid,
.etf-menu-mobile .etf-panel:not([data-panel="featured"]) .etf-list:not(.etf-list-grid) {
  grid-template-columns: 1fr;
  max-height: none;
  overflow: visible;
  gap: 0;
}

.etf-menu-mobile .etf-list li a {
  padding: 10px 8px;
  border-radius: 8px;
}
.etf-menu-mobile .etf-list li a:hover,
.etf-menu-mobile .etf-list li a:active {
  background: rgba(36, 56, 232, 0.06);
}
.etf-menu-mobile .etf-ticker {
  font-size: 12px;
  min-width: 72px;
  padding: 5px 10px;
}
.etf-menu-mobile .etf-name {
  font-size: 14px;
  line-height: 1.3;
}

.etf-menu-mobile .etf-menu-actions {
  margin-top: 24px;
  padding-top: 20px;
  gap: 24px;
}
.etf-menu-mobile .etf-action-link {
  padding: 6px 0;
  font-size: 15px;
}

.etf-menu-mobile .etf-panel-eyebrow {
  font-size: 11px;
  letter-spacing: 2.5px;
  margin-bottom: 10px;
  color: #2438e8;
}
