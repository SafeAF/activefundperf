    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function() {
            var articles = document.querySelectorAll('.wp-block-kadence-infobox');
            var loadMoreBtn = document.getElementById('load-more-btn');
            var articlesToShow = 8;
            var currentIndex = 8;

            // Function to show articles
            function showArticles() {
                for (var i = currentIndex; i < currentIndex + articlesToShow && i < articles.length; i++) {
                    articles[i].classList.add('show');
                }
                currentIndex += articlesToShow;
                if (currentIndex >= articles.length) {
                    loadMoreBtn.style.display = 'none';
                }
            }

            // Initial load (show first 11 articles)
            for (var i = 0; i < currentIndex && i < articles.length; i++) {
                articles[i].classList.add('show');
            }

            // Event listener for the "Load More" button
            loadMoreBtn.addEventListener('click', showArticles);
        });
    </script>
    <script>
(function() {
    var BANNER_SELECTORS = [
        "#wpfront-notification-bar-12",
        "#wpfront-notification-bar-7",
        "#wpfront-notification-bar-4",
        "#wpfront-notification-bar-26",
		"#wpfront-notification-bar-27",
		"#wpfront-notification-bar-31"
    ];
    var HEADER_SELECTOR = ".header.sticky, header.header.dark.sticky, header.header.light.sticky";
    var MAIN_SELECTOR = "main#primary";

    var observedBanner = null;
    var bannerObserver = null;
    var rafId = null;

    // Return the banner if it EXISTS — regardless of current height.
    // It may be mid slide-in animation or display:none.
    function findBanner() {
        for (var i = 0; i < BANNER_SELECTORS.length; i++) {
            var el = document.querySelector(BANNER_SELECTORS[i]);
            if (el) return el;
        }
        return null;
    }

    function applyLayout() {
        rafId = null;
        var banner = findBanner();
        var header = document.querySelector(HEADER_SELECTOR);
        var mainContent = document.querySelector(MAIN_SELECTOR);

        // Keep the ResizeObserver pointed at the current banner element,
        // attaching as soon as it exists so we catch the open animation.
        if (banner !== observedBanner) {
            if (bannerObserver && observedBanner) bannerObserver.unobserve(observedBanner);
            observedBanner = banner;
            if (banner && typeof ResizeObserver !== "undefined") {
                if (!bannerObserver) bannerObserver = new ResizeObserver(scheduleUpdate);
                bannerObserver.observe(banner);
            }
        }

        // Measure actual rendered height (0 when closed/hidden/not yet open).
        var bannerHeight = banner ? banner.getBoundingClientRect().height : 0;

        if (bannerHeight > 0) {
            if (header) header.style.top = bannerHeight + "px";
            if (mainContent) mainContent.style.marginTop = bannerHeight + "px";
        } else {
            if (header) header.style.top = "";
            if (mainContent) mainContent.style.marginTop = "";
        }
    }

    function scheduleUpdate() {
        if (rafId !== null) return;
        rafId = requestAnimationFrame(applyLayout);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", scheduleUpdate);
    } else {
        scheduleUpdate();
    }
    window.addEventListener("load", scheduleUpdate);
    window.addEventListener("resize", scheduleUpdate);

    // Watch body for the bar being added OR removed (dismiss resets layout).
    function startBodyObserver() {
        if (!document.body) return;
        var bodyObserver = new MutationObserver(function(mutations) {
            for (var i = 0; i < mutations.length; i++) {
                var lists = [mutations[i].addedNodes, mutations[i].removedNodes];
                for (var l = 0; l < lists.length; l++) {
                    for (var j = 0; j < lists[l].length; j++) {
                        var node = lists[l][j];
                        if (node.nodeType === 1 && node.id &&
                            node.id.indexOf("wpfront-notification-bar") === 0) {
                            scheduleUpdate();
                            return;
                        }
                    }
                }
            }
        });
        bodyObserver.observe(document.body, { childList: true });
    }
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", startBodyObserver);
    } else {
        startBodyObserver();
    }
})();
</script>
      <script>
    (function(){
      function parseSortVal(td, type){
        const v = (td.getAttribute('data-sort') || '').trim();
        if (!v) return null;

        if (type === 'amount') {
          const n = Number(v);
          return Number.isFinite(n) ? n : null;
        }

        // date: expect YYYY-MM-DD in data-sort (we stored that)
        if (type === 'date') {
          // Keep as string "YYYY-MM-DD" for safe lexicographic compare
          return v;
        }

        return v.toLowerCase();
      }

      function initDistTable(ui){
        const table = ui.querySelector('table.def-dist-table');
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        const ths = Array.from(table.querySelectorAll('thead th'));
        const perPageSelect = ui.querySelector('.def-dist-perpage');
        const info = ui.querySelector('.def-dist-info');
        const pager = ui.querySelector('.def-dist-pagination');

        // default per page from shortcode
        const defaultPerPage = Number(ui.getAttribute('data-default-per-page') || 7);
        perPageSelect.value = String(defaultPerPage);

        let state = {
          perPage: defaultPerPage,
          page: 1,
          sortCol: 3,      // default: Payable Date
          sortDir: 'desc'  // latest first
        };

        function clearSortClasses(){
          ths.forEach(th => th.classList.remove('def-dist-sorted-asc','def-dist-sorted-desc'));
        }

        function sortRows(){
          const col = state.sortCol;
          const th = ths[col];
          const type = th.getAttribute('data-type') || 'text';

          rows.sort((a,b)=>{
            const atd = a.children[col];
            const btd = b.children[col];
            const av = parseSortVal(atd, type);
            const bv = parseSortVal(btd, type);

            // nulls last
            if (av === null && bv === null) return 0;
            if (av === null) return 1;
            if (bv === null) return -1;

            let cmp = 0;
            if (typeof av === 'number' && typeof bv === 'number') {
              cmp = av - bv;
            } else {
              cmp = String(av).localeCompare(String(bv));
            }
            return state.sortDir === 'asc' ? cmp : -cmp;
          });

          clearSortClasses();
          th.classList.add(state.sortDir === 'asc' ? 'def-dist-sorted-asc' : 'def-dist-sorted-desc');
        }

        function render(){
          sortRows();

          const total = rows.length;
          const startIndex = (state.page - 1) * state.perPage;
          const endIndex = Math.min(startIndex + state.perPage, total);

          // render body
          tbody.innerHTML = '';
          rows.slice(startIndex, endIndex).forEach(r => tbody.appendChild(r));

          // info
          const showingStart = total === 0 ? 0 : startIndex + 1;
          const showingEnd = endIndex;
          info.textContent = `Showing ${showingStart} to ${showingEnd} of ${total} entries`;

          // pager
          const totalPages = Math.max(1, Math.ceil(total / state.perPage));
          pager.innerHTML = '';

          const makeBtn = (label, page, disabled=false, current=false) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'def-dist-pagebtn';
            btn.textContent = label;
            if (disabled) btn.disabled = true;
            if (current) btn.setAttribute('aria-current', 'page');
            btn.addEventListener('click', ()=> {
              state.page = page;
              render();
            });
            return btn;
          };

          pager.appendChild(makeBtn('‹', Math.max(1, state.page - 1), state.page === 1));

          // show up to 7 page buttons
          const maxBtns = 7;
          let start = Math.max(1, state.page - 3);
          let end = Math.min(totalPages, start + (maxBtns - 1));
          start = Math.max(1, end - (maxBtns - 1));

          for (let p = start; p <= end; p++){
            pager.appendChild(makeBtn(String(p), p, false, p === state.page));
          }

          pager.appendChild(makeBtn('›', Math.min(totalPages, state.page + 1), state.page === totalPages));
        }

        // events
        perPageSelect.addEventListener('change', () => {
          // Re-read current sort from the header classes (prevents flipping order)
          const sortedIdx = ths.findIndex(th =>
            th.classList.contains('def-dist-sorted-asc') ||
            th.classList.contains('def-dist-sorted-desc')
          );

          if (sortedIdx >= 0) {
            state.sortCol = sortedIdx;
            state.sortDir = ths[sortedIdx].classList.contains('def-dist-sorted-asc') ? 'asc' : 'desc';
          } else {
            // Fallback: Payable Date newest on top
            state.sortCol = 3;
            state.sortDir = 'desc';
          }

          state.perPage = Number(perPageSelect.value || 7);
          state.page = 1;
          render();
        });

        ths.forEach((th, idx)=>{
          th.addEventListener('click', ()=>{
            if (state.sortCol === idx) {
              state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
            } else {
              state.sortCol = idx;
              state.sortDir = 'asc';
            }
            state.page = 1;
            render();
          });
        });

        // initial state: payable date desc
        state.sortCol = 3;
        state.sortDir = 'desc';
        render();
      }

      document.addEventListener('DOMContentLoaded', ()=>{
        document.querySelectorAll('.def-dist-ui[data-dist-ui="1"]').forEach(initDistTable);
      });
    })();
  </script>
      <script>
    (function () {
      function spcu_nb_tick() {
        var target = new Date('2026-06-12T09:30:00-04:00');
        var diff = target - new Date();
        if (diff <= 0) {
          ['d','h','m','s'].forEach(function(u) {
            var el = document.getElementById('spcu-nb-' + u);
            if (el) el.textContent = '00';
          });
          return;
        }
        var vals = {
          d: Math.floor(diff / 86400000),
          h: Math.floor((diff % 86400000) / 3600000),
          m: Math.floor((diff % 3600000) / 60000),
          s: Math.floor((diff % 60000) / 1000)
        };
        Object.keys(vals).forEach(function(u) {
          var el = document.getElementById('spcu-nb-' + u);
          if (el) el.textContent = String(vals[u]).padStart(2, '0');
        });
      }
      spcu_nb_tick();
      setInterval(spcu_nb_tick, 1000);
    })();
    </script>
