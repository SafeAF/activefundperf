body table.tidal-holdings-table tbody tr:nth-child(odd) td { background-color: rgba(249, 249, 249, 1) !important; }

/* Table-Specific Alternating Row Color Overrides */

/* Fund Background Image Classes */
.fund-header-bg { background-image: url(); background-size: cover; background-position: center; background-repeat: no-repeat; }
.fund-about-bg { background-image: url(); background-size: cover; background-position: center; background-repeat: no-repeat; }
.fund-divider-bg { background-image: url(); background-size: cover; background-position: center; background-repeat: no-repeat; }

/* Holdings Table Pagination */
.twm-holdings-pagination { margin-top: 20px; display: flex; justify-content: center; }
.twm-pagination-nav { display: flex; gap: 8px; align-items: center; }
.twm-pagination-number, .twm-pagination-arrow { font-family: Arial, sans-serif; font-size: 14px; font-weight: 400; color: rgba(16, 90, 122, 1) !important; background-color: rgba(255, 255, 255, 1) !important; border: 1px solid rgba(16, 90, 122, 0.3); padding: 8px 12px; cursor: pointer; transition: all 0.3s ease; border-radius: 4px; min-width: 40px; text-align: center; }
.twm-pagination-number:hover:not(.active):not(:disabled), .twm-pagination-arrow:hover:not(:disabled) { background-color: rgba(240, 240, 240, 1) !important; }
.twm-pagination-number.active { color: rgba(255, 255, 255, 1) !important; background-color: rgba(16, 90, 122, 1) !important; border-color: rgba(16, 90, 122, 1); cursor: default; }
.twm-pagination-arrow:disabled { opacity: 0.4; cursor: not-allowed; }
.twm-pagination-arrow { font-size: 18px; line-height: 1; padding: 8px 14px; }

</style>
