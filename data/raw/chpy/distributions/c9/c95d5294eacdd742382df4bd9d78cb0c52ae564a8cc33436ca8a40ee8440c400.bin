			    <script>
    (function () {
      function ymReplaceTrademarks(node) {
        if (node.nodeType === Node.TEXT_NODE) {
          var v = node.nodeValue || "";
          v = v.replace(/YieldMax[\s\u00A0]*\u00ae+/g, "YieldMax");
          v = v.replace(/YieldMax(?=\s)/g, "YieldMax\u00ae");
          v = v.replace(/Target 25[\s\u00A0]*\u2122+/g, "Target 25");
          v = v.replace(/Target 25(?=\s)/g, "Target 25\u2122");
          v = v.replace(/Target 12[\s\u00A0]*\u2122+/g, "Target 12");
          v = v.replace(/Target 12(?=\s)/g, "Target 12\u2122");
          if (v !== node.nodeValue) node.nodeValue = v;
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          if (node.tagName === "SCRIPT" || node.tagName === "STYLE" || node.isContentEditable) return;
          if (node.closest && node.closest(".no-r")) return;
          for (var i = 0; i < node.childNodes.length; i++) ymReplaceTrademarks(node.childNodes[i]);
        }
      }
      document.addEventListener("DOMContentLoaded", function () {
        ymReplaceTrademarks(document.body);
      });
    })();
    </script>
    <script>
(function() {
  var scrolling = false;
  window.addEventListener('scroll', function() {
    if (scrolling) return;
    scrolling = true;
    
    // Try multiple possible selectors for the open menu trigger
    var triggers = document.querySelectorAll('.elementor-element-9cd9e50 [aria-expanded="true"]');
    triggers.forEach(function(trigger) {
      trigger.click();
    });
    
    // Also try forcing the dropdown closed directly
    var dropdown = document.querySelector('.elementor-element-9cd9e50 .e-n-menu-content > .e-con');
    if (dropdown) {
      dropdown.style.display = 'none';
      setTimeout(function() {
        dropdown.style.display = '';
      }, 50);
    }

    setTimeout(function() {
      scrolling = false;
    }, 100);
  }, { passive: true });
})();
</script>

<script type="text/javascript">window.addEventListener("DOMContentLoaded",(e=>{document.querySelectorAll('img[loading="lazy"]').forEach((e=>{e.getBoundingClientRect().top<=window.innerHeight&&(e.loading="eager")}))}));</script><script>
        document.addEventListener("DOMContentLoaded", function() {
            document.querySelectorAll(".tidal-performance-table:not(.twm-no-hover-table)").forEach(function(table) {
                var headerRow = table.querySelector("thead tr");
                if (!headerRow) return;

                var allCols = headerRow.querySelectorAll("th");
                var totalCols = allCols.length;

                if (totalCols < 2) return;

                var firstColWidth = 12;
                var lastColWidth = 15;
                var secondLastColWidth = 15;

                var usedWidth = firstColWidth;
                allCols[0].style.setProperty("width", firstColWidth + "%", "important");

                if (totalCols >= 2) {
                    usedWidth += lastColWidth;
                    allCols[totalCols - 1].style.setProperty("width", lastColWidth + "%", "important");
                }

                if (totalCols >= 3) {
                    usedWidth += secondLastColWidth;
                    allCols[totalCols - 2].style.setProperty("width", secondLastColWidth + "%", "important");
                }

                var middleCols = totalCols - 3;

                if (middleCols > 0) {
                    var remainingWidth = 100 - usedWidth;
                    var middleColWidth = remainingWidth / middleCols;

                    for (var i = 1; i < totalCols - 2; i++) {
                        allCols[i].style.setProperty("width", middleColWidth + "%", "important");
                    }
                }

                table.querySelectorAll("tbody tr").forEach(function(row) {
                    var cells = row.querySelectorAll("td");
                    if (cells[0]) cells[0].style.setProperty("width", firstColWidth + "%", "important");
                    if (cells[totalCols - 1]) cells[totalCols - 1].style.setProperty("width", lastColWidth + "%", "important");
                    if (totalCols >= 3 && cells[totalCols - 2]) cells[totalCols - 2].style.setProperty("width", secondLastColWidth + "%", "important");

                    if (middleCols > 0) {
                        var remainingWidth = 100 - usedWidth;
                        var middleColWidth = remainingWidth / middleCols;
                        for (var i = 1; i < totalCols - 2; i++) {
                            if (cells[i]) cells[i].style.setProperty("width", middleColWidth + "%", "important");
                        }
                    }
                });
            });

            document.querySelectorAll(".tidal-performance-table.twm-no-hover-table").forEach(function(table) {
                var headerRow = table.querySelector("thead tr");
                if (!headerRow) return;

                var allCols = headerRow.querySelectorAll("th");
                var totalCols = allCols.length;

                if (totalCols < 1) return;

                var evenWidth = 100 / totalCols;

                for (var i = 0; i < totalCols; i++) {
                    allCols[i].style.setProperty("width", evenWidth + "%", "important");
                }

                table.querySelectorAll("tbody tr").forEach(function(row) {
                    var cells = row.querySelectorAll("td");
                    for (var i = 0; i < cells.length; i++) {
                        cells[i].style.setProperty("width", evenWidth + "%", "important");
                    }
                });
            });
        });
        </script>	</body>
