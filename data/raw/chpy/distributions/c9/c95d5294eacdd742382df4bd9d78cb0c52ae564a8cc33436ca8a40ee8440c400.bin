  --sub-yield: #02ffec;
  --sub-yield-deep: #02cabd;
  --sub-danger: #ff7a8a;
  --sub-field: #10204f;
  --sub-radius: 12px;

  max-width: 773px;
  margin: 0 auto;
  background: var(--sub-ink-soft);
  border: 1px solid var(--sub-line);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 24px 60px -28px rgba(0, 0, 0, .7);
  font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
}

.ym-form .hsfc-Renderer {
  --hsf-global__font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;

  --hsf-heading__color: var(--sub-text);
  --hsf-richtext__font-size: 19.5px;
  --hsf-richtext__color: var(--sub-muted);

  --hsf-button__font-size: 20.5px;
  --hsf-button__font-weight: 700;
  --hsf-button__color: #02112e;
  --hsf-button__background-color: var(--sub-yield);
  --hsf-button__background-image: linear-gradient(180deg, var(--sub-yield), var(--sub-yield-deep));
  --hsf-button__border-radius: var(--sub-radius);
  --hsf-button__border-style: none;
  --hsf-button__padding: 14px;
  --hsf-button__width: 100%;
  --hsf-button--hover__background-color: var(--sub-yield);

  --hsf-field-label__font-size: 17px;
  --hsf-field-label__color: var(--sub-text);
  --hsf-field-label-requiredindicator__color: var(--sub-yield);

  --hsf-field-description__font-size: 15.5px;
  --hsf-field-description__color: var(--sub-muted);

  --hsf-field-footer__color: var(--sub-faint);

  --hsf-field-input__font-size: 20px;
  --hsf-field-input__color: var(--sub-text);
  --hsf-field-input__background-color: var(--sub-field);
  --hsf-field-input__placeholder-color: var(--sub-muted);
  --hsf-field-input__border-color: var(--sub-line);
  --hsf-field-input__border-radius: var(--sub-radius);
  --hsf-field-input__padding: 12px 14px;

  --hsf-field-checkbox__background-color: #ffffff;
  --hsf-field-checkbox__border-color: var(--sub-muted);
  --hsf-field-checkbox__color: #02112e;

  --hsf-field-dropdown-options__border-radius: var(--sub-radius);

  --hsf-erroralert__color: var(--sub-danger);
  --hsf-infoalert__color: var(--sub-muted);

  --hsf-row__horizontal-spacing: 14px;
  --hsf-row__vertical-spacing: 20px;

  --hsf-background__border-style: none;
  --hsf-background__padding: 28px 34px 32px;
}

.ym-form .hsfc-Step__Content {
  display: flex !important;
  flex-direction: column !important;
}

.ym-form .hsfc-NavigationRow {
  margin-top: 12px !important;
}

.ym-form .hsfc-FieldLabel {
  color: var(--sub-text) !important;
}

.ym-form .hsfc-RichText {
  color: var(--sub-muted) !important;
}

.ym-form .hsfc-FieldLabel span,
.ym-form .hsfc-FieldLabel strong,
