			<script>(function () {
  var PORTAL_ID = '51151753';

  var FORMS = [
    '5c6a8163-3cf5-443c-8693-68dd8631f129',
    '89eb8df4-49db-4533-a75a-5c112d3bfa2f'
  ];

  function setup(container) {
    container.classList.add('ym-form');

    function bind(button) {
      if (button.dataset.ymBound) return;
      button.dataset.ymBound = 'true';
      button.addEventListener('click', function () {
        container.classList.add('ym-submitted');
      });
    }

    function killTransform(button) {
      if (button.dataset.ymTransformKilled) return;
      button.dataset.ymTransformKilled = 'true';
      button.style.setProperty('transform', 'none', 'important');
      var styleObserver = new MutationObserver(function () {
        if (button.style.transform !== 'none') {
          button.style.setProperty('transform', 'none', 'important');
        }
      });
      styleObserver.observe(button, { attributes: true, attributeFilter: ['style'] });
    }

    function wrapRegisteredMarks(root) {
      var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
      var nodes = [];
      var node;
      while ((node = walker.nextNode())) {
        if (node.nodeValue.indexOf('®') !== -1 && node.parentNode.tagName !== 'SUP') {
          nodes.push(node);
        }
      }
      nodes.forEach(function (textNode) {
        var parts = textNode.nodeValue.split('®');
        if (parts.length < 2) return;
        var frag = document.createDocumentFragment();
        parts.forEach(function (part, i) {
          if (part) frag.appendChild(document.createTextNode(part));
          if (i < parts.length - 1) {
            var sup = document.createElement('sup');
            sup.textContent = '®';
            frag.appendChild(sup);
          }
        });
        textNode.parentNode.replaceChild(frag, textNode);
      });
    }

    function refresh() {
      container.classList.toggle('ym-has-group', !!container.querySelector('.hsfc-CheckboxFieldGroup'));
      var button = container.querySelector('button[type="submit"]');
      if (button) {
        bind(button);
        killTransform(button);
      }
      wrapRegisteredMarks(container);
    }

    refresh();
    new MutationObserver(refresh).observe(container, { childList: true, subtree: true });
  }

  function convert(container) {
    Array.prototype.forEach.call(container.querySelectorAll('iframe'), function (frame) {
      frame.parentNode.removeChild(frame);
    });
    container.style.removeProperty('height');
    container.classList.remove('hs-form-frame');
    container.classList.add('hs-form-html');
  }

  function loadRenderer() {
    var script = document.createElement('script');
    script.src = 'https://js.hsforms.net/forms/embed/developer/' + PORTAL_ID + '.js';
    script.defer = true;
    document.head.appendChild(script);
  }

  function init() {
    var containers = document.querySelectorAll('.hs-form-frame, .hs-form-html');
    var converted = false;
    Array.prototype.forEach.call(containers, function (container) {
      var portal = container.getAttribute('data-portal-id');
      if (FORMS.indexOf(container.getAttribute('data-form-id')) === -1) return;
      if (portal && portal !== PORTAL_ID) return;
      if (container.classList.contains('ym-form')) return;
      if (container.classList.contains('hs-form-frame')) {
        convert(container);
        converted = true;
      }
      setup(container);
    });
    if (converted) loadRenderer();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script><style class="wpcode-css-snippet">.white-grey {
