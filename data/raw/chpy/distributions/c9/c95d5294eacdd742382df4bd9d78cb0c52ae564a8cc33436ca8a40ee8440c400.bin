<style id='ym-custom-styles'>
/* YieldMax Manager Custom Styles v1.2.6 */

/* Elementor Icon Sizing Fix */
.elementor-icon svg { width: 100% !important; height: 100% !important; max-width: 100% !important; max-height: 100% !important; }
.elementor-icon { display: flex !important; align-items: center !important; justify-content: center !important; }

/* Reset All Table Borders - Override Theme/Elementor (will be overridden by global borders if set) */
.tidal-table-container, .tidal-table-container *, .tidal-csv-table, .tidal-csv-table *, .tidal-performance-table, .tidal-performance-table *, .tidal-holdings-table, .tidal-holdings-table *, table.tidal-csv-table, table.tidal-performance-table, table.tidal-holdings-table { border: 0; border-top: 0; border-right: 0; border-bottom: 0; border-left: 0; border-style: none; border-width: 0; }

