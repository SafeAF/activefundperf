}</style><style class="wpcode-css-snippet">.fund-info-table {
    width: 100%;
    max-width: 100%;
    font-family: inherit;
    font-size: 18px;
    background: transparent;
}
.fund-info-table thead th {
    background: #0044bd !important;
    color: #fff !important;
    font-weight: 600 !important;
    font-family: inherit !important;
    text-transform: none;
    letter-spacing: 0.01em;
}
.fund-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #ffffff;
    padding: 12px 0;
    width: 100%;
}
.fund-label {
    color: #ffffff;
    font-weight: 500;
    flex: 1 1 55%;
    text-align: left;
}
.fund-value {
    color: #ffffff;
    text-align: right;
    font-weight: 400;
    flex: 1 1 45%;
}
.fund-row:last-child {
    border-bottom: 1px solid #ffffff;
}
.performance-table-wrap,
.distributions-table-wrap {
    font-weight: 400;
    font-size: 14px;
    color: #003087;
    margin-bottom: 0;
}
.performance-table,
.distributions-table {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
    max-width: 100%;
    background: #fff;
    table-layout: auto;
}
.performance-table thead th,
.distributions-table thead th {
    background: #ffffff !important;
    color: #627084 !important;
    font-weight: 600 !important;
    font-size: 14px;
    text-align: center;
    padding: 10px 8px 8px 8px;
    border: none;
    vertical-align: middle;
    letter-spacing: 0.01em;
    text-transform: uppercase;
}
.performance-table thead th:not(:nth-last-child(-n+2)),
.distributions-table thead th:not(:nth-last-child(-n+2)) {
    white-space: nowrap;
}
.performance-table thead th:nth-last-child(2),
.performance-table thead th:last-child,
.distributions-table thead th:nth-last-child(2),
.distributions-table thead th:last-child {
    white-space: normal;
    word-break: break-word;
}
.performance-table thead th:first-child,
.distributions-table thead th:first-child {
    text-align: left;
    padding-left: 18px;
}

.performance-table ,
.distributions-table {
	border: 1px solid #E1E6EA !important;
}
.performance-table thead th,
.distributions-table thead th,
.performance-table tbody td,
.distributions-table tbody td {
    background: #fff;
    color: #627084;
    font-weight: 500;
    font-size: 14px;
    text-align: center;
    padding: 10px 8px 8px 8px;
    border: none;
    border-bottom: 1px solid #E1E6EA;
    vertical-align: middle;
}
.performance-table tbody tr:last-child td,
.distributions-table tbody tr:last-child td {
    border-bottom: none;
    padding-bottom: 0;
}
.performance-table tbody td:first-child,
.distributions-table tbody td:first-child {
    text-align: left;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding-left: 18px;
    width: 140px;
}
.performance-table th,
.performance-table td,
.distributions-table th,
.distributions-table td {
    border-left: none !important;
}
th, thead th, table th {
    background: #0044bd !important;
    color: #fff !important;
    font-weight: 700 !important;
    font-family: inherit !important;
}

/* Hide all but the first 2 rows in performance-table only */
.performance-table tbody tr:nth-child(n+3) {
    display: none;
}
.holdings-table-wrap {
    font-weight: 400;
    font-size: 14px;
