</script><script>(function() {
  // Run after Elementor renders and on page load
  const runWhenReady = (fn) => {
    if (document.readyState === "complete" || document.readyState === "interactive") {
      setTimeout(fn, 0);
    } else {
      document.addEventListener("DOMContentLoaded", fn);
    }
    // Elementor frontend hook (if present)
    if (window.elementorFrontend && elementorFrontend.hooks) {
      elementorFrontend.hooks.addAction("frontend/element_ready/global", fn);
    }
  };

  function tryParseDate(str) {
    // Supports 2025-11-05 or 11/05/2025 etc.
    const iso = /^\d{4}-\d{2}-\d{2}/.test(str);
    const us  = /^\d{1,2}\/\d{1,2}\/\d{2,4}/.test(str);
    let t = NaN;
    if (iso || us) t = Date.parse(str);
    return isNaN(t) ? null : t;
  }

  function parseMaybeNumberOrDate(txt) {
    const cleaned = (txt || "").trim();
    // number?
    const num = parseFloat(cleaned.replace(/[^0-9.\-]+/g, ""));
    if (!isNaN(num) && cleaned.match(/[0-9]/)) return { type: "num", val: num };
    // date?
    const dt = tryParseDate(cleaned);
    if (dt !== null) return { type: "date", val: dt };
    // text
    return { type: "txt", val: cleaned.toLowerCase() };
  }

  function initSorter(root) {
    const wrap = root.querySelector("#fundsTableWrap") || document.querySelector("#fundsTableWrap");
    if (!wrap) return;

    // Find a real table inside
    const table = wrap.querySelector("table") || wrap;
    const thead = table.querySelector("thead");
    const tbody = table.querySelector("tbody");

    if (!thead || !tbody) return; // not a standard table; see fallback below

    const headers = Array.from(thead.querySelectorAll("th"));
    if (!headers.length) return;

    // Avoid double-binding
    if (table.__sortableBound) return;
    table.__sortableBound = true;

    headers.forEach((th, colIdx) => {
      th.style.cursor = "pointer";
      th.addEventListener("click", () => {
        const asc = !th.classList.contains("asc");
        headers.forEach(h => h.classList.remove("asc","desc"));
        th.classList.add(asc ? "asc" : "desc");

        const rows = Array.from(tbody.querySelectorAll("tr"));
        rows.sort((a, b) => {
          // Prefer a data-sort value if you add one; else use text
          const getCell = (row) => {
            const cell = row.children[colIdx];
            if (!cell) return "";
            const ds = cell.getAttribute("data-sort");
            return ds !== null ? ds : cell.textContent || cell.innerText || "";
          };

          const A = parseMaybeNumberOrDate(getCell(a));
          const B = parseMaybeNumberOrDate(getCell(b));

          let cmp = 0;
          if (A.type === B.type) {
            if (A.type === "num" || A.type === "date") {
              cmp = A.val - B.val;
            } else {
              cmp = A.val.localeCompare(B.val, undefined, { numeric: true, sensitivity: "base" });
            }
          } else {
            // Force a stable type order: numbers > dates > text
            const order = { num: 2, date: 1, txt: 0 };
            cmp = order[A.type] - order[B.type];
          }

          return asc ? cmp : -cmp;
        });

        rows.forEach(r => tbody.appendChild(r));
      });
    });
  }

  function observeAndInit() {
    // In case the widget renders late / via AJAX
    const root = document.body;
    const kick = () => initSorter(root);

    // Try immediately and a few retries
    let tries = 0;
    const iid = setInterval(() => {
      tries++;
      kick();
      if (tries > 20) clearInterval(iid);
    }, 250);

    // Also watch for DOM changes inside our wrapper
    const wrap = document.querySelector("#fundsTableWrap");
    if (wrap && !wrap.__observer) {
      const mo = new MutationObserver(() => kick());
      mo.observe(wrap, { childList: true, subtree: true });
      wrap.__observer = mo;
    }
  }

  runWhenReady(observeAndInit);
})();
</script><style class="wpcode-css-snippet">/* Wrap the button container */
.ym-btn .elementor-button-wrapper {
  width: 100%;
  height: 100%;
}

/* Make the <a> element fill the wrapper */
.ym-btn .elementor-button {
  display: flex !important;
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  font-family: inherit !important;
  font-size: 26px !important;
  line-height: 1.15 !important;
  font-weight: 700 !important;
}

/* Center and size inner content */
.ym-btn .elementor-button-content-wrapper {
  display: flex !important;
  align-items: center;
  justify-content: center;
  text-align: center;
  width: 100%;
  height: 100%;
  min-height: 220px;
  padding: 2em 0.5em;
  box-sizing: border-box;
}

/* Handle line breaks and first word styling */
.ym-btn br {
  display: block;
  line-height: 0;
}

.ym-btn .ym-first {
  display: inline;
}

/* Tablet */
@media (max-width: 1024px) {
  .ym-btn .elementor-button {
    font-size: 20px !important;
  }
  .ym-btn .elementor-button-content-wrapper {
    min-height: 200px !important;
    padding: 2em 0.5em !important;
  }
}

/* Mobile */
@media (max-width: 767px) {
  .ym-btn .elementor-button {
    font-size: 14px !important;
  }
  .ym-btn .elementor-button-content-wrapper {
    min-height: 140px !important;
    padding: 0.2em !important;
  }
}</style><style class="wpcode-css-snippet">/* Base table (no column sizing) */
