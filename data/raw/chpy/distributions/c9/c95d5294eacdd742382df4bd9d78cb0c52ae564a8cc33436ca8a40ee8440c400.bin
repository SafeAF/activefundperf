<style>.admin-only { display: none !important; }</style><style id="twm-tooltip-styles">
.twm-tooltip {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
}

.twm-tooltip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    margin-left: 6px;
    font-size: 14px;
    color: rgba(255, 255, 255, 1);
    line-height: 1;
    box-sizing: border-box;
    transition: color 0.2s ease;
}

.twm-tooltip:hover .twm-tooltip-icon {
    color: rgba(204, 204, 204, 1);
}

.twm-tooltip-icon .dashicons {
    width: 18px;
    height: 18px;
    font-size: 18px;
}

.twm-tooltip-icon img {
    width: 16px;
    height: 16px;
    object-fit: contain;
}

.twm-tooltip-icon .twm-tooltip-svg svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
    vertical-align: middle;
}

#twm-tooltip-popup {
    position: fixed;
    top: 0;
    left: 0;
    max-width: 380px;
    min-width: 260px;
    background: rgba(255, 255, 255, 1);
    color: rgba(0, 0, 0, 1);
    font-family: Arial, sans-serif;
    font-size: 14px;
    padding: 12px;
    line-height: 1.4em;
    border: 1px solid rgba(204, 204, 204, 1);
    border-radius: 6px;
    box-shadow: 0 4px 12px rgba(0,0,0,.15);    white-space: normal;
    overflow-wrap: break-word;
    word-break: normal;
    z-index: 999999;
    display: none;
    transition: color 0.2s ease;
}

#twm-tooltip-popup:hover {
    color: rgba(0, 0, 0, 1);
}

@media (max-width: 768px) {
    #twm-tooltip-popup {
        max-width: calc(100vw - 20px);
        min-width: 200px;
    }
}
</style>
<style>
        .performance-table th, .performance-table td { text-align: center; }
        .performance-table th:first-child, .performance-table td:first-child { text-align: left; }
        .performance-table-wrap { overflow-x: auto; }
        .performance-table { border-collapse: collapse; width: 100%; }
        .performance-table th, .performance-table td { padding: 8px 12px; border: 1px solid #e0e0e0; }
        .performance-table thead th { background: #f9f9f9; }
    </style>        <style>
        .twm-fund-buttons-container {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin: 20px 0;
        }

        a.twm-fund-button,
        a.twm-fund-button:link,
        a.twm-fund-button:visited {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background-color: #2271b1;
            color: #ffffff;
            border: 1px solid #2271b1;
            border-radius: 4px;
            padding: 12px;
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        a.twm-fund-button:hover,
        a.twm-fund-button:focus {
            background-color: #135e96;
            color: #ffffff;
