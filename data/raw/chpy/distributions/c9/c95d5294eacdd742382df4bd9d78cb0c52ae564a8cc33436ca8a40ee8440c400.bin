}
 */
/* Text containers & links default: blue text with typography */
.dce-acf-repeater-item .repeater-item,
.dce-acf-repeater-item .elementor-repeater-item-5571527,
.dce-acf-repeater-item .repeater-item a,
.dce-acf-repeater-item .elementor-repeater-item-5571527 a,
.dce-acf-repeater-item > a,
.repeater-item.elementor-repeater-item-5571527 a {
  color: #0044bd !important;
  text-decoration: none !important;
  font-family: "Mukta","Helvetica Neue",Arial,sans-serif !important;
  font-size: 1em !important;
  font-weight: 600 !important;
  font-style: normal !important;
  text-transform: none !important;
  letter-spacing: 0 !important;
  line-height: 1.25 !important;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  display: inline-block !important;
  transition: color .18s !important;
		transition-duration: .3s;
    transition-property: transform;
}

/* Hover / Focus: BLUE background, WHITE text & icon */
.dce-acf-repeater-item:hover,
.dce-acf-repeater-item:focus {
  background: #0044bd !important;
  color: #ffffff !important;
  border-color: #0044bd !important;
	transform: scale(1.1);
}

