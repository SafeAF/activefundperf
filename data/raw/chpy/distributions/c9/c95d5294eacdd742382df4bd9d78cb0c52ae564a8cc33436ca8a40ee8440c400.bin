}

.ym-form .hsfc-CheckboxFieldGroup__Options input.hsfc-CheckboxInput:checked {
  background-color: var(--sub-yield) !important;
  border-color: var(--sub-yield) !important;
}

.ym-form .hsfc-DataPrivacyField .hsfc-RichText {
  font-size: 17px !important;
  color: rgba(234, 240, 255, .85) !important;
