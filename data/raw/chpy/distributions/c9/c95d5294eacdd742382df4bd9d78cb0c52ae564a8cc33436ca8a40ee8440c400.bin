<script>
(function(){
  var RATE=0.15,QUALITY_MIN='hd720',PREFETCH=0.20,OBS_ROOT_MARGIN='600px';
  var QUALITY_ORDER=['tiny','small','medium','large','hd720','hd1080','highres'];

  function ensureYT(cb){
    if(window.YT&&window.YT.Player) return cb();
    var s=document.querySelector('script[src*="youtube.com/iframe_api"]');
    if(!s){s=document.createElement('script');s.src='https://www.youtube.com/iframe_api';document.head.appendChild(s);}
    var t=setInterval(function(){if(window.YT&&window.YT.Player){clearInterval(t);cb();}},50);
  }

  function parseId(src){
    if(!src) return null;
    var m=src.match(/\/embed\/([^?&/]+)/);
    return m?m[1]:null;
  }

  function chooseQuality(levels,min){
    if(!levels||!levels.length) return null;
    var idx=function(q){var i=QUALITY_ORDER.indexOf(q);return i===-1?-1:i};
    var minIdx=idx(min),bestAtOrAbove=null,bestOverall=null,hasLarge=false;
    levels.forEach(function(q){
      if(q==='auto'||q==='default') return;
      if(q==='large') hasLarge=true;
      if(!bestOverall||idx(q)>idx(bestOverall)) bestOverall=q;
      if(minIdx!==-1&&idx(q)>=minIdx){ if(!bestAtOrAbove||idx(q)>idx(bestAtOrAbove)) bestAtOrAbove=q; }
    });
    if(bestAtOrAbove) return bestAtOrAbove;
    if(hasLarge) return 'large';
    return bestOverall;
  }

  function pinQuality(p){
    try{
      var levels=p.getAvailableQualityLevels?p.getAvailableQualityLevels():[];
      var target=chooseQuality(levels,QUALITY_MIN);
      if(target) p.setPlaybackQuality(target);
      return target;
    }catch(e){return null;}
  }

  function pickNearestRate(p,desired){
    try{
      var rates=p.getAvailablePlaybackRates?p.getAvailablePlaybackRates():[];
      if(rates&&rates.length){
        var best=rates[0],diff=Math.abs(best-desired);
        for(var i=1;i<rates.length;i++){var r=rates[i],d=Math.abs(r-desired); if(d<diff){best=r;diff=d;}}
        return best;
      }
    }catch(e){}
    return 1;
  }

  function buildOverlay(container){
    var overlay=document.createElement('div'); overlay.className='yt-bg-overlay';
    var mount=document.createElement('div'); mount.className='yt-mount';
    overlay.appendChild(mount); container.appendChild(overlay);
    return {overlay:overlay,mount:mount};
  }

  function replaceWithControlled(section, origIframe){
    if(section.__ytBgReplaced) return;
    var container=section.querySelector('.elementor-background-video-container'); if(!container) return;
    var src=origIframe.getAttribute('src')||''; var vid=parseId(src); if(!vid) return;

    origIframe.setAttribute('data-yt-hidden','1');

    var nodes=buildOverlay(container);
    var inView=false,rafId=0,duration=null;

    var player=new YT.Player(nodes.mount,{
      width:'100%',height:'100%',
      videoId:vid,
      playerVars:{autoplay:1,controls:0,playsinline:1,rel:0,modestbranding:1,iv_load_policy:3,fs:0,mute:1},
      events:{
        onReady:function(e){
          try{
            e.target.mute(); e.target.playVideo();
            var r=pickNearestRate(e.target,RATE); e.target.setPlaybackRate(r);
            setTimeout(function(){try{e.target.setPlaybackRate(pickNearestRate(e.target,RATE))}catch(_e){}},800);
            setTimeout(function(){try{e.target.setPlaybackRate(pickNearestRate(e.target,RATE))}catch(_e){}},3000);
            pinQuality(e.target);
            setTimeout(function(){try{pinQuality(e.target)}catch(_e){}},1000);
            setTimeout(function(){try{pinQuality(e.target)}catch(_e){}},4000);
            console.log('[yt-bg] replaced', vid, 'rate', r);
          }catch(_e){}
        },
        onPlaybackQualityChange:function(){ try{pinQuality(player)}catch(_e){}; },
        onStateChange:function(e){
          if(e.data===YT.PlayerState.ENDED){
            try{e.target.seekTo(0,true); e.target.playVideo();}catch(_e){}
          }
        }
      }
    });

    function tick(){
      if(!inView) return;
      try{
        if(duration==null){ var d=player.getDuration?player.getDuration():0; if(d&&isFinite(d)) duration=d; }
        if(!duration){ rafId=requestAnimationFrame(tick); return; }
        var t=player.getCurrentTime?player.getCurrentTime():0;
        var switchAt=Math.max(0, duration - Math.max(0.05, PREFETCH));
        if(t>=switchAt){
          try{player.seekTo(0,true); player.playVideo();}catch(_e){}
        }
      }catch(_e){}
      rafId=requestAnimationFrame(tick);
    }

    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(ent){
        if(ent.isIntersecting){
          inView=true; try{player.playVideo();}catch(_e){}; cancelAnimationFrame(rafId); rafId=requestAnimationFrame(tick);
        }else{
          inView=false; cancelAnimationFrame(rafId); try{player.pauseVideo();}catch(_e){}
        }
      });
    },{root:null,rootMargin:OBS_ROOT_MARGIN,threshold:0.01});
    io.observe(section);

    section.__ytBgReplaced=true;
  }

  function scan(){
    document.querySelectorAll('.elementor-background-video-container iframe[src*="youtube.com/embed/"]').forEach(function(ifr){
      var section=ifr.closest('.elementor-section'); if(!section) return;
      replaceWithControlled(section, ifr);
    });
  }

  function init(){ ensureYT(scan); }

  var mo=new MutationObserver(function(){ scan(); });
  mo.observe(document.documentElement,{childList:true,subtree:true,attributes:true,attributeFilter:['src']});
  document.addEventListener('DOMContentLoaded',init);
  window.addEventListener('load',scan);
  init(); scan();
})();
</script>
