        <script>
        (function(){
            if(window.__ym_pdf_csv_handler_loaded) return;
            window.__ym_pdf_csv_handler_loaded = true;

            function applyTargetBlank(){
                var pdfLinks = document.querySelectorAll('a[href$=".pdf"], a[href*=".pdf?"]');
                var csvLinks = document.querySelectorAll('a[href$=".csv"], a[href*=".csv?"]');
                var allLinks = Array.prototype.slice.call(pdfLinks).concat(Array.prototype.slice.call(csvLinks));

                for(var i=0; i<allLinks.length; i++){
                    try{
                        allLinks[i].setAttribute('target', '_blank');
                        allLinks[i].setAttribute('rel', 'noopener noreferrer');
                    } catch(e){}
                }
            }

            if(document.readyState === 'loading'){
                document.addEventListener('DOMContentLoaded', applyTargetBlank);
            } else {
                applyTargetBlank();
            }
        })();
        </script>
