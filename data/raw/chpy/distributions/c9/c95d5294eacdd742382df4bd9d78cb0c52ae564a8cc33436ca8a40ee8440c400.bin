.ym-form.ym-has-group .hsfc-CheckboxFieldGroup > .hsfc-CheckboxFieldGroup__Options { order: 6; }
.ym-form.ym-has-group .hsfc-Step__Content > .hsfc-NavigationRow {
  order: 7;
