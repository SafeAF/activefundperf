        <style>
            html {
                margin-top: 0 !important;
            }
            body.admin-bar {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }
            body:not(.wp-admin) #wpadminbar {
                position: fixed !important;
                top: -32px !important;
                left: 0 !important;
                right: 0 !important;
                opacity: 0 !important;
                transition: top 0.2s ease, opacity 0.2s ease !important;
                z-index: 99999 !important;
            }
            body:not(.wp-admin) #wpadminbar.show-bar {
                top: 0 !important;
                opacity: 1 !important;
            }
            #wpadminbar #wp-admin-bar-ym-managed-badge {
                background-color: #1fb4fe !important;
            }
            #wpadminbar #wp-admin-bar-ym-managed-badge .ab-item {
                background-color: #1fb4fe !important;
                padding: 0 12px !important;
                height: 32px !important;
                display: flex !important;
                align-items: center !important;
            }
            #wpadminbar #wp-admin-bar-ym-managed-badge .ym-managed-badge {
                font-size: 16px !important;
                font-weight: 700 !important;
                color: #ffffff !important;
                line-height: 32px !important;
                letter-spacing: 0.5px !important;
            }
            #wpadminbar #wp-admin-bar-ym-managed-badge:hover .ab-item {
                background-color: #1fb4fe !important;
            }
        </style>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                if (document.body.classList.contains('wp-admin')) return;

                var adminBar = document.getElementById('wpadminbar');
                if (!adminBar) return;

                var showTimeout, hideTimeout;
                var isOverBar = false;

                adminBar.addEventListener('mouseenter', function() {
                    isOverBar = true;
                    clearTimeout(hideTimeout);
                    adminBar.classList.add('show-bar');
                });

                adminBar.addEventListener('mouseleave', function() {
                    isOverBar = false;
                    hideTimeout = setTimeout(function() {
                        adminBar.classList.remove('show-bar');
                    }, 300);
                });

                document.addEventListener('mousemove', function(e) {
                    if (e.clientY <= 5) {
                        clearTimeout(hideTimeout);
                        showTimeout = setTimeout(function() {
                            adminBar.classList.add('show-bar');
                        }, 100);
                    } else if (e.clientY > 40 && !isOverBar) {
                        clearTimeout(showTimeout);
                        hideTimeout = setTimeout(function() {
                            adminBar.classList.remove('show-bar');
                        }, 300);
                    }
                });
            });
        </script>
