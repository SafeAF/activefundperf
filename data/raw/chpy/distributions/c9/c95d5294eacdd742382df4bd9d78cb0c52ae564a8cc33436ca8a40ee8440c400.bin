  background-color: var(--sub-field) !important;
  color: var(--sub-text) !important;
}

.ym-form .hsfc-TextInput:hover,
.ym-form .hsfc-TextareaInput:hover {
  box-shadow: none !important;
}

.ym-form .hsfc-TextInput:focus,
.ym-form .hsfc-TextareaInput:focus {
  box-shadow: 0 0 0 3px rgba(2, 255, 236, .16) !important;
}

.ym-form .hsfc-TextInput:-webkit-autofill,
.ym-form .hsfc-TextInput:-webkit-autofill:hover,
.ym-form .hsfc-TextInput:-webkit-autofill:focus {
  -webkit-text-fill-color: var(--sub-text) !important;
  -webkit-box-shadow: 0 0 0 1000px var(--sub-field) inset !important;
  box-shadow: 0 0 0 1000px var(--sub-field) inset !important;
