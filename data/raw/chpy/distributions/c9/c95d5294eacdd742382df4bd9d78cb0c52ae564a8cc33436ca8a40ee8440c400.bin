/* Start custom CSS for container, class: .elementor-element-808eef8 *//* Normal state */
.elementor-element-6663581 {
  transition: box-shadow 0.3s ease;
}

.elementor-element-7de5170,
.elementor-element-7de5170 .e-con-inner {
  transition: all 0.3s ease;
    padding-top: 10px;
    padding-bottom: 10px;
}

/* After scroll — shrink padding, remove min-height, add shadow */
.elementor-sticky--effects.elementor-element-6663581 {
  min-height: 0px !important;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
}

.elementor-sticky--effects .elementor-element-7de5170 {
  min-height: 0px !important;
}

.elementor-sticky--effects .elementor-element-7de5170 .e-con-inner {
  min-height: 0px !important;
  padding-top: 5px !important;
  padding-bottom: 5px !important;
}

/* Logo */
.site-logo img {
  height: 68px;
  width: auto;
  transition: height 0.3s ease;
}

.elementor-sticky--effects .site-logo img {
  height: 50px !important;
  width: auto !important;
}/* End custom CSS */
/* Start custom CSS */#edu-roc {
  width: max-content !important;
  margin: -30px 550px 0 auto !important;
}


.ym-anchored-panel {
  position: absolute;
  top: 100%;
  left: 0;
  width: max-content;
  margin: -30px 0 0 0;
}

.ym-nav button:hover{
    border: 0px !important;
}

.elementor-widget-n-menu .e-n-menu {
    display: flex;
    flex-direction: row;
    position: relative;
    justify-content: flex-end;
}

/* Alternative if header is NOT sticky */
.elementor-element-9cd9e50 .e-n-menu-content > .e-con {
  position: absolute !important;
  left: 50% !important;
  transform: translateX(-50%) !important;
  width: 100vw !important;
  max-width: 100vw !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
}


@media (max-width: 767px) {
  /* Hide the mega menu dropdown on mobile */
  .elementor-element-9cd9e50 .e-n-menu-content {
    display: none !important;
  }
  
  /* Make the parent link clickable (not a dropdown trigger) */
  .elementor-element-9cd9e50 .e-n-menu-heading {
    pointer-events: auto !important;
  }
  
  /* Remove the dropdown arrow if there is one */
  .elementor-element-9cd9e50 .e-n-menu-heading .e-n-menu-heading__icon {
    display: none !important;
  }
}/* End custom CSS */
