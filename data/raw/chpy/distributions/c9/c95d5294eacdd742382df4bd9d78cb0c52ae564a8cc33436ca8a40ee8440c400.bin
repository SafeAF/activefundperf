/* White Outline Button */
.white-outline .elementor-button {
  background: transparent !important;
  color: #fff !important;
  border: 2px solid #fff !important;
  border-radius: 4px !important;
}

.white-outline .elementor-button:hover {
  background: rgba(255, 255, 255, 0.15) !important; /* slight white transparent hover */
  color: #fff !important;
}

.white-outline .elementor-button.is-selected {
  background: #fff !important;
  color: #0044bd !important; /* reversed text color when selected */
  border-color: #fff !important;
}

/* Blue Outline Button */

.blue-outline .elementor-button {
  background: #fff !important;
  color: #0044bd !important;
  border: 2px solid #0044bd !important;
  border-radius: 4px !important;
}
.blue-outline .elementor-button:hover {
  background: #0044bd !important;
  color: #fff !important;
}
.blue-outline .elementor-button.is-selected {
  background: #0044bd !important;
  color: #fff !important;
  border-color: #0044bd !important;
}


/* Search Buttons */

.search-filter-input-button {
  background-color: #ffffff !important;
  color: #0044bd !important;
  border: 2px solid #0044bd !important;
  border-radius: 4px !important;
  font-weight: 600 !important;
  text-transform: uppercase !important;
  font-size: 14px !important;
  padding: 20px 26px !important;
  cursor: pointer !important;
  display: inline-block !important;
  margin: 0 6px 6px 0 !important;
}

.search-filter-input-button__count {
  color: #0044bd !important;
  font-weight: normal !important;
  font-size: 13px !important;
}

.search-filter-input-button:hover {
  background-color: #0044bd !important;
  color: #ffffff !important;
}

.search-filter-input-button:hover .search-filter-input-button__count {
  color: #ffffff !important;
}

button.search-filter-input-button.search-filter-input-button--is-selected {
  background-color: #0044bd !important;
  color: #ffffff !important;
  border-color: #0044bd !important;
}

button.search-filter-input-button.search-filter-input-button--is-selected .search-filter-input-button__count {
  color: #ffffff !important;
}
/* base track stays light grey */
.search-filter-component-range-slider__range-input-progress{
  position: relative;
  height: 8px;
  border-radius: 999px;
  background: #d3d3d3;           /* your existing light grey */
  overflow: hidden;               /* keep rounded ends clean */
}

/* only the selected range gets the gradient */
.search-filter-component-range-slider__range-input-progress::before{
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, #02FFEC 0%, #9EFF02 100%);
  clip-path: inset(0 calc(100% - var(--high)) 0 var(--low)); /* show only low→high */
}


.elementor-element.blur {
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 16px;
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.elementor-button-icon {
  display: flex;
  align-items: center;
}

h1 {
  line-height: 1.15em !important;
}

/* p {
  line-height: 1.8em !important;
} */

/* Force full color (no transparency) for text inside Elementor forms */
.elementor-form .elementor-field {
  opacity: 1 !important;
}

/* Force full color (no transparency) for placeholder text */
.elementor-form .elementor-field::placeholder {
  opacity: 1 !important;
}
