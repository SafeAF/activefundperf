/* User-Controlled Borders (High Specificity Override) */

/* Global Alternating Row Colors */
body table.tidal-csv-table tbody tr:nth-child(even) td { background-color: rgba(255, 255, 255, 1) !important; }
body table.tidal-csv-table tbody tr:nth-child(odd) td { background-color: rgba(249, 249, 249, 1) !important; }
body table.tidal-performance-table tbody tr:nth-child(even) td { background-color: rgba(255, 255, 255, 1) !important; }
body table.tidal-performance-table tbody tr:nth-child(odd) td { background-color: rgba(249, 249, 249, 1) !important; }
