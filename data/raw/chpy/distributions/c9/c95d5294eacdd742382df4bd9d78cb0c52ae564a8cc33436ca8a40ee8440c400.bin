}</style><style class="wpcode-css-snippet">.search-filter-component-range-slider__range-text {
  display: flex;
  justify-content: space-between; /* min left, max right */
  margin-bottom: 6px;             /* spacing above track */
  font-size: 16px;
  font-family: inherit;
  font-weight: 600;
}

.search-filter-component-range-slider__range-text-min,
.search-filter-component-range-slider__range-text-max {
  margin: 0; 
}

/* #fundsTableWrap th::after {
  font-size: 0.7em;
