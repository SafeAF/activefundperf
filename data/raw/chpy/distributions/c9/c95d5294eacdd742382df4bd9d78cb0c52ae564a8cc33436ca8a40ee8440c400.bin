		<div id="twm-tooltip-popup"></div>
<script>
/* TWM Tooltip Script - Fixed for long content */
(function(){
    var pop = document.getElementById('twm-tooltip-popup');
    if (!pop) return;

    function clamp(n, min, max) {
        return Math.max(min, Math.min(max, n));
    }

    function show(el, html) {
        pop.innerHTML = html;
        pop.style.display = 'block';
        requestAnimationFrame(function() {
            var r = el.getBoundingClientRect();
            var b = pop.getBoundingClientRect();
            var m = 10;

            var top = r.top - b.height - m;
            if (top < m) {
                top = r.bottom + m;
            }

            if (top + b.height > window.innerHeight - m) {
                top = r.top - b.height - m;
            }

            var left = r.left + (r.width / 2) - (b.width / 2);
            left = clamp(left, m, window.innerWidth - b.width - m);
            top = clamp(top, m, window.innerHeight - b.height - m);

            pop.style.top = top + 'px';
            pop.style.left = left + 'px';
        });
    }

    function hide() {
        pop.style.display = 'none';
        pop.innerHTML = '';
    }

    document.addEventListener('pointerenter', function(e) {
        var t = e.target.closest && e.target.closest('.twm-tooltip');
        if (!t || e.pointerType === 'touch') return;
        var tipId = t.getAttribute('data-twm-tooltip-id');
        if (!tipId) return;
        var tipEl = document.getElementById(tipId);
        if (!tipEl) return;
        show(t, tipEl.textContent);
    }, true);

    document.addEventListener('pointerleave', function(e) {
        var t = e.target.closest && e.target.closest('.twm-tooltip');
        if (!t || e.pointerType === 'touch') return;
        hide();
    }, true);

    document.addEventListener('click', function(e) {
        var t = e.target.closest && e.target.closest('.twm-tooltip');
        if (!t) {
            hide();
            return;
        }
        e.preventDefault();
        var tipId = t.getAttribute('data-twm-tooltip-id');
        if (!tipId) return;
        var tipEl = document.getElementById(tipId);
        if (!tipEl) return;
        show(t, tipEl.textContent);
    });

    document.addEventListener('scroll', hide, true);
    window.addEventListener('resize', hide);
})();
</script>
        <style>
            .elementor-control-promotion,
            .elementor-control-type-promotion,
            .elementor-nerd-box,
            .elementor-nerd-box-message,
            .elementor-control-notice,
            .elementor-control-type-notice,
            .e-control-promotion,
            .e-control-notice,
            div[class*="promotion"],
            div[class*="elementor-control"][class*="promotion"],
            .elementor-control-raw-html.elementor-panel-alert,
            .elementor-panel-alert.elementor-panel-alert-info,
            .elementor-panel-alert.elementor-panel-alert-warning {
                display: none !important;
            }
        </style>
        <script>
            (function() {
                function removeElementorPromotions() {
                    if (typeof jQuery === 'undefined') return;

                    jQuery('.elementor-control-promotion').remove();
                    jQuery('.elementor-control-type-promotion').remove();
                    jQuery('.elementor-nerd-box').remove();
                    jQuery('.elementor-control-notice').remove();
                    jQuery('.e-control-promotion').remove();
                    jQuery('.e-control-notice').remove();

                    jQuery('.elementor-control-raw-html').each(function() {
                        var text = jQuery(this).text().toLowerCase();
                        if (text.indexOf('optimize') !== -1 ||
                            text.indexOf('image optimizer') !== -1 ||
                            text.indexOf('install plugin') !== -1 ||
                            text.indexOf('upgrade') !== -1 ||
                            text.indexOf('pro') !== -1 ||
                            text.indexOf('seo') !== -1 ||
                            text.indexOf('rank math') !== -1 ||
                            text.indexOf('yoast') !== -1 ||
                            text.indexOf('get elementor') !== -1 ||
                            text.indexOf('elementor pro') !== -1 ||
                            text.indexOf('go pro') !== -1 ||
                            text.indexOf('premium') !== -1 ||
                            text.indexOf('upsell') !== -1 ||
                            text.indexOf('try it now') !== -1 ||
                            text.indexOf('learn more') !== -1 && text.indexOf('upgrade') !== -1) {
                            jQuery(this).closest('.elementor-control').remove();
                        }
                    });

                    jQuery('.elementor-panel-alert').each(function() {
                        var text = jQuery(this).text().toLowerCase();
                        if (text.indexOf('optimize') !== -1 ||
                            text.indexOf('image optimizer') !== -1 ||
                            text.indexOf('install plugin') !== -1 ||
                            text.indexOf('seo') !== -1 ||
                            text.indexOf('upgrade') !== -1 ||
                            text.indexOf('pro') !== -1 ||
                            text.indexOf('premium') !== -1) {
                            jQuery(this).remove();
                        }
                    });
                }

                if (typeof elementor !== 'undefined') {
                    elementor.on('panel:init', removeElementorPromotions);
                    elementor.on('preview:loaded', removeElementorPromotions);
                }

                setInterval(removeElementorPromotions, 1000);

                if (typeof jQuery !== 'undefined') {
                    jQuery(document).ready(removeElementorPromotions);
                }
            })();
        </script>
        			<script>
				( () => {
					const lazyloadRunObserver = () => {
						const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
						const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
							entries.forEach( ( entry ) => {
								if ( entry.isIntersecting ) {
									let lazyloadBackground = entry.target;
									if( lazyloadBackground ) {
										lazyloadBackground.classList.add( 'e-lazyloaded' );
									}
									lazyloadBackgroundObserver.unobserve( entry.target );
								}
							});
						}, { rootMargin: '200px 0px 200px 0px' } );
						lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
							lazyloadBackgroundObserver.observe( lazyloadBackground );
						} );
					};
					const events = [
						'DOMContentLoaded',
						'elementor/lazyload/observe',
					];
					events.forEach( ( event ) => {
						document.addEventListener( event, lazyloadRunObserver );
					} );
				} )();
			</script>
			<script>(function () {
  'use strict';

  const TARGET_SELECTOR = '.ym-split .elementor-button-text';

  function splitFirst(el) {
    if (!el || el.dataset.ymSplit) return;
    if (!el.closest('.ym-split')) return;

    const text = (el.textContent || '').trim();
    const m = text.match(/^(\S+)\s+([\s\S]+)$/);
    el.dataset.ymSplit = '1';
    if (!m) return;

    const first = m[1];
    const rest = m[2];
    el.innerHTML = '<span class="ym-first">' + first + '</span><br>' + rest;
  }

  function processAll(root) {
    const scope = (root && root.querySelectorAll) ? root : document;
    scope.querySelectorAll(TARGET_SELECTOR).forEach(splitFirst);
  }

  if (window.elementorFrontend?.hooks?.addAction) {
    window.elementorFrontend.hooks.addAction('frontend/element_ready/widget', (scope) => {
      const node = scope?.[0] || scope || document;
      processAll(node);
    });
    window.elementorFrontend.hooks.addAction('frontend/init', () => processAll(document));
  }

  document.addEventListener('DOMContentLoaded', () => processAll(document));

  const observer = new MutationObserver((mutations) => {
    for (const m of mutations) {
      for (const node of m.addedNodes) {
        if (node.nodeType !== 1) continue;
        if (node.matches?.(TARGET_SELECTOR)) splitFirst(node);
        node.querySelectorAll?.(TARGET_SELECTOR).forEach(splitFirst);
      }
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });

  window.ymElementorSplitFirstWord = processAll;
})();</script><style id="global-styles-inline-css">
