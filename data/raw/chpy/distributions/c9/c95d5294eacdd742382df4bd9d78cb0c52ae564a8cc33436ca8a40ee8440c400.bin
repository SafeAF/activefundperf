.dce-acf-repeater-list,
.dce-no-list {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 14px !important;
  padding: 0 !important;
  margin: 0 !important;
  list-style: none !important;
}

/* Item: default WHITE background, BLUE text (non-hover) */
.dce-acf-repeater-item {
  display: inline-flex !important;
  align-items: center !important;
  background: #ffffff !important;
  border: 2px solid #0044bd !important;
  border-radius: 4px !important;
  padding: 12px 40px !important;          /* top/right/bottom/left */
  color: #0044bd !important;
  gap: 10px !important;
  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;
  box-sizing: border-box !important;
  margin: 0 !important;
  line-height: 1.25 !important;
  text-decoration: none !important;
  cursor: pointer !important;
  transition: background .18s, color .18s, border-color .18s !important;
  font-family: "Mukta","Helvetica Neue",Arial,sans-serif !important;
  font-size: 1rem !important;             /* Size */
  font-weight: 600 !important;            /* Semi Bold */
  font-style: normal !important;          /* Style Default */
  text-transform: none !important;        /* Transform Default */
  text-decoration: none !important;       /* Decoration Default */
  letter-spacing: 0 !important;
  white-space: nowrap !important;
	transition-duration: .3s !important;
    transition-property: transform !important;
}

/* Icon default: blue */
